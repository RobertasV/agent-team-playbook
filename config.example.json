{
  "owner_accounts": ["your-github-login"],
  "agent_account": "your-ai-account",
  "repos": ["you/your-project"],
  "checkout": "/path/to/your-project",
  "labels": {
    "working": "in progress",
    "question": "question for owner",
    "deferred": "deferred",
    "waiting": "waiting for other project",
    "priority": "priority",
    "blocking": "blocking",
    "hard": "hard",
    "owner_word": "waits for owner's word",
    "batch": "check batch",
    "health": "agent health",
    "checked": "checked: {role}"
  },
  "skip_labels": ["after launch"],
  "default_role": "programmer",
  "roles": [
    {
      "role": "programmer",
      "label": "programmer",
      "mode": "programmer",
      "model": "",
      "effort": "xhigh",
      "hard_effort": "max",
      "merge": true,
      "session": "",
      "description": "Default role: every task nobody else owns. The only role that interprets the owner's words."
    },
    {
      "role": "checker",
      "label": "checker",
      "mode": "checker",
      "n": 5,
      "hours": 24,
      "paths": [],
      "model": "",
      "release_model": "",
      "effort": "xhigh",
      "hard_effort": "max",
      "merge": false,
      "session": "",
      "description": "Checks batches of finished tasks. The full release check runs only on the owner's word."
    }
  ],
  "dispatcher": {
    "folder": "",
    "session": "",
    "model": "",
    "effort": "low"
  },
  "poll_seconds": 60,
  "stale_hours": 24,
  "watch_grace_minutes": 30,
  "lesson_examples": 5,
  "repeat_minutes": 30,
  "forward_hours": 24,
  "idle_minutes": 20,
  "escalate_minutes": 30,
  "check_minutes": 60,
  "accept_issues_from_others": false,
  "tests": {"mode": "per-task", "full": "", "every": 5, "checkout": "", "branch": "main"},
  "codex_model": "",
  "worktree_idle_hours": 12,
  "live": {"role": "checker", "command": "~/bin/restart-my-app.sh {sha}"},
  "texts": {
    "take": "taking this.",
    "ask": "{text}",
    "defer": "deferred. {text}",
    "wait": "waiting for {ref}.",
    "back": "{ref} is closed – back in the queue.",
    "assign": "→ {role}.",
    "queued": "queued for {role}.",
    "route": "→ {role}. {text}",
    "batch_title": "Check: {refs}",
    "checked": "checked {refs}. {text}",
    "health_title": "Agent team health"
  }
}
