class Fail(Exception):
    pass


# ---------- basics ----------

def now():
    fixed = os.environ.get('AGENTQ_NOW')
    if fixed:
        return parse_time(fixed)
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def parse_time(text):
    return dt.datetime.fromisoformat(text.replace('Z', '+00:00'))


def iso(moment):
    return moment.astimezone(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def gh(*args):
    for attempt in range(3):  # GitHub sometimes answers 502/503 or times out for a moment
        run = subprocess.run(['gh', *args], capture_output=True, text=True)
        transient = re.search(r'\b50[234]\b|timeout|timed out|connection reset', run.stderr, re.I)
        if run.returncode == 0 or not transient or attempt == 2:
            break
        time.sleep(2 * (attempt + 1))
    if run.returncode != 0:
        raise Fail(f"gh {' '.join(args[:3])}: {run.stderr.strip() or run.stdout.strip()}")
    return run.stdout


def gh_json(*args):
    out = gh(*args)
    return json.loads(out) if out.strip() else []


def gh_pages(*args):
    """`gh api --paginate` prints one JSON array per page; join them."""
    out, items, at = gh(*args), [], 0
    decoder = json.JSONDecoder()
    while True:
        while at < len(out) and out[at].isspace():
            at += 1
        if at >= len(out):
            return items
        value, at = decoder.raw_decode(out, at)
        items += value if isinstance(value, list) else [value]


def git(checkout, *args):
    run = subprocess.run(['git', '-C', os.path.expanduser(checkout), *args], capture_output=True, text=True)
    if run.returncode != 0:
        raise Fail(f"git {' '.join(args[:2])}: {run.stderr.strip()}")
    return run.stdout


# ---------- config and state ----------

def find_config(explicit):
    """--config, then AGENTQ_CONFIG, then the nearest .agentq.json from here up (the project opted in), then the user default."""
    if explicit:
        return explicit
    if os.environ.get('AGENTQ_CONFIG'):
        return os.environ['AGENTQ_CONFIG']
    starts = [os.getcwd()]
    session = os.environ.get('CLAUDE_CODE_HOST_SESSION_ID')  # run from a scratch folder: the session's own project
    if session:
        apps = os.path.expanduser(os.environ.get('AGENTQ_APP_SESSIONS') or
                                  '~/Library/Application Support/Claude/claude-code-sessions')
        for meta in glob.glob(os.path.join(glob.escape(apps), '*', '*', f'{glob.escape(session)}.json')):
            try:
                with open(meta, encoding='utf-8') as f:
                    data = json.load(f)
            except (OSError, ValueError):
                continue
            starts += [d for d in (data.get('cwd'), data.get('originCwd')) if d]
    for here in starts:
        while True:
            candidate = os.path.join(here, PROJECT_CONFIG)
            if os.path.exists(candidate):
                return candidate
            parent = os.path.dirname(here)
            if parent == here:
                break
            here = parent
    return DEFAULT_CONFIG


def number(text):
    value = float(text)
    return int(value) if value.is_integer() else value


def role_entry(raw):
    role = {'label': raw['role'], 'mode': 'programmer', 'n': 5, 'hours': 24, 'paths': [], 'model': '',
            'release_model': '', 'effort': '', 'hard_effort': '', 'session': '', 'description': '', 'examples': [],
            'shots': [], **raw}
    role.setdefault('merge', role['mode'] == 'programmer')
    role.setdefault('agent', 'claude')  # another agent (codex, …) pulls its tasks with `agentq next`
    role['sessions'] = [x for x in (raw.get('sessions') or [raw.get('session')]) if x]  # several sessions: a pool
    active = raw.get('active')
    role['pool'] = role['sessions'][:active] if active is not None else role['sessions']  # the rest rest, kept
    role['session'] = (role['pool'] or role['sessions'] or [''])[0]
    if role['mode'] not in MODES:
        raise Fail(f'role {role["role"]}: mode must be one of {", ".join(MODES)}')
    return role


