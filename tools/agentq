#!/usr/bin/env python3
"""agentq – the task queue of an agent team on GitHub issues.

One command changes a task's state completely (comment + labels), so an agent
cannot do half of it and forget the rest. Everything goes through `gh`, signed
in as the AI account. See README.md, docs/DESIGN.md and config.example.json.

The code is in agentq_lib/ beside this script, one module per part (see agentq_lib/__init__.py).
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))  # agentq_lib, also when run as `python -I agentq`

from agentq_lib.cli import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main())
