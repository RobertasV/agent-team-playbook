#!/usr/bin/env python3
"""agentq – the task queue of an agent team on GitHub issues.

One command changes a task's state completely (comment + labels), so an agent
cannot do half of it and forget the rest. Everything goes through `gh`, signed
in as the AI account. See README.md and config.example.json.
"""
import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys

DEFAULT_CONFIG = os.path.expanduser('~/.config/agentq/config.json')
PROJECT_CONFIG = '.agentq.json'
WAIT_MARK = re.compile(r'<!-- agentq:wait ([\w.-]+/[\w.-]+)#(\d+) -->')
REF = re.compile(r'^(?:([\w.-]+/[\w.-]+)#)?#?(\d+)$')
DEFAULT_TEXTS = {
    'take': 'taking this.',
    'ask': '{text}',
    'defer': 'deferred. {text}',
    'wait': 'waiting for {ref}.',
    'back': '{ref} is closed – back in the queue.',
}


class Fail(Exception):
    pass


def now():
    fixed = os.environ.get('AGENTQ_NOW')
    if fixed:
        return parse_time(fixed)
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def parse_time(text):
    return dt.datetime.fromisoformat(text.replace('Z', '+00:00'))


def iso(moment):
    return moment.astimezone(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def gh(*args):
    run = subprocess.run(['gh', *args], capture_output=True, text=True)
    if run.returncode != 0:
        raise Fail(f"gh {' '.join(args[:3])}: {run.stderr.strip() or run.stdout.strip()}")
    return run.stdout


def gh_json(*args):
    out = gh(*args)
    return json.loads(out) if out.strip() else []


def find_config(explicit):
    """--config, then AGENTQ_CONFIG, then the nearest .agentq.json from here up (the project opted in), then the user default."""
    if explicit:
        return explicit
    if os.environ.get('AGENTQ_CONFIG'):
        return os.environ['AGENTQ_CONFIG']
    here = os.getcwd()
    while True:
        candidate = os.path.join(here, PROJECT_CONFIG)
        if os.path.exists(candidate):
            return candidate
        parent = os.path.dirname(here)
        if parent == here:
            return DEFAULT_CONFIG
        here = parent


def load_config(path):
    try:
        with open(path, encoding='utf-8') as f:
            cfg = json.load(f)
    except FileNotFoundError:
        raise Fail(f'no config at {path} (copy config.example.json there, or pass --config)')
    for key in ('owner_accounts', 'agent_account', 'role', 'repos', 'labels'):
        if not cfg.get(key):
            raise Fail(f'config {path}: "{key}" is missing')
    for key in ('working', 'question', 'deferred', 'waiting'):
        if not cfg['labels'].get(key):
            raise Fail(f'config {path}: "labels.{key}" is missing')
    cfg['texts'] = {**DEFAULT_TEXTS, **cfg.get('texts', {})}
    skip = set(cfg.get('skip_labels', []))
    skip.update(cfg['labels'][k] for k in ('question', 'deferred', 'waiting'))
    cfg['skip'] = skip
    cfg['state_file'] = os.path.expanduser(cfg.get('state_file') or os.path.realpath(path) + '.state.json')
    cfg['stale_hours'] = cfg.get('stale_hours', 24)
    return cfg


def load_state(cfg):
    try:
        with open(cfg['state_file'], encoding='utf-8') as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def save_state(cfg, state):
    tmp = cfg['state_file'] + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, cfg['state_file'])


def resolve(cfg, ref):
    m = REF.match(ref.strip())
    if not m:
        raise Fail(f'"{ref}" is not an issue (use N, #N or owner/repo#N)')
    repo = m.group(1) or cfg['repos'][0]
    if repo not in cfg['repos']:
        raise Fail(f'{repo} is not in this config (repos: {", ".join(cfg["repos"])})')
    return repo, int(m.group(2))


def labels_of(issue):
    return [l['name'] for l in issue.get('labels', [])]


def one_line(text, size=200):
    text = ' '.join(text.split())
    return text if len(text) <= size else text[:size - 1] + '…'


def open_issues(repo):
    return gh_json('issue', 'list', '-R', repo, '--state', 'open', '--limit', '500',
                   '--json', 'number,title,labels,updatedAt,comments')


def comment(cfg, repo, number, text):
    body = f"🤖 {cfg['role']}: {text}"
    gh('issue', 'comment', str(number), '-R', repo, '--body', body)


def relabel(repo, number, add=(), remove=()):
    args = ['issue', 'edit', str(number), '-R', repo]
    for name in add:
        args += ['--add-label', name]
    for name in remove:
        args += ['--remove-label', name]
    if len(args) > 5:
        gh(*args)


def cmd_queue(cfg, opts):
    state = load_state(cfg)
    started = now()
    lines = []
    for repo in cfg['repos']:
        since = state.get(repo, {}).get('last')
        issues = open_issues(repo)
        if since is None:
            lines.append(f'{repo}: first run – owner comments from now on will be shown.')
        else:
            since_t = parse_time(since)
            news = []
            for issue in issues:
                for c in issue.get('comments', []):
                    if c['author']['login'] in cfg['owner_accounts'] and parse_time(c['createdAt']) > since_t:
                        news.append(f"  {repo}#{issue['number']} {one_line(issue['title'], 60)}: {one_line(c['body'])}")
            lines.append(f'{repo}: owner comments since {since}: {len(news) or "none"}')
            lines.extend(news)
        working, todo, skipped = [], [], {}
        for issue in sorted(issues, key=lambda i: i['number']):
            names = labels_of(issue)
            hit = [n for n in names if n in cfg['skip']]
            row = f"  {repo}#{issue['number']} [{', '.join(names)}] {one_line(issue['title'], 100)}"
            if cfg['labels']['working'] in names:
                working.append(row)
            elif hit:
                for n in hit:
                    skipped[n] = skipped.get(n, 0) + 1
            else:
                todo.append(row)
        if working:
            lines.append(f'{repo}: in progress ({len(working)}):')
            lines.extend(working)
        lines.append(f'{repo}: queue ({len(todo)}):')
        lines.extend(todo)
        if opts.all and skipped:
            lines.append('  skipped: ' + ', '.join(f'{k} {v}' for k, v in sorted(skipped.items())))
        state.setdefault(repo, {})['last'] = iso(started)
    print('\n'.join(lines))
    if not opts.peek:
        save_state(cfg, state)


def cmd_take(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    comment(cfg, repo, number, cfg['texts']['take'])
    relabel(repo, number, add=[cfg['labels']['working']])
    print(f'{repo}#{number}: taken')


def cmd_ask(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    comment(cfg, repo, number, cfg['texts']['ask'].format(text=opts.text))
    relabel(repo, number, add=[cfg['labels']['question']], remove=[cfg['labels']['working']])
    print(f'{repo}#{number}: asked the owner, out of the queue')


def cmd_defer(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    comment(cfg, repo, number, cfg['texts']['defer'].format(text=opts.text or '').strip())
    relabel(repo, number, add=[cfg['labels']['deferred']], remove=[cfg['labels']['working']])
    print(f'{repo}#{number}: deferred')


def cmd_wait(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    m = re.match(r'^([\w.-]+/[\w.-]+)#(\d+)$', opts.other.strip())
    if not m:
        raise Fail(f'"{opts.other}" must be owner/repo#N')
    ref = f'{m.group(1)}#{m.group(2)}'
    text = cfg['texts']['wait'].format(ref=ref) + f'\n<!-- agentq:wait {ref} -->'
    comment(cfg, repo, number, text)
    relabel(repo, number, add=[cfg['labels']['waiting']], remove=[cfg['labels']['working']])
    print(f'{repo}#{number}: waits for {ref}')


def cmd_check(cfg, opts):
    moment = now()
    stale = dt.timedelta(hours=cfg['stale_hours'])
    report, fixed = [], []
    for repo in cfg['repos']:
        for issue in open_issues(repo):
            names = labels_of(issue)
            tag = f"{repo}#{issue['number']}"
            comments = issue.get('comments', [])
            if cfg['labels']['working'] in names and moment - parse_time(issue['updatedAt']) > stale:
                report.append(f"{tag}: '{cfg['labels']['working']}' but nothing happened for over {cfg['stale_hours']} h")
            if comments and comments[-1]['author']['login'] in cfg['owner_accounts']:
                report.append(f"{tag}: the owner's comment waits for an answer – {one_line(comments[-1]['body'], 120)}")
            if cfg['labels']['waiting'] in names:
                marks = [m for c in comments for m in WAIT_MARK.findall(c.get('body', ''))]
                if not marks:
                    report.append(f"{tag}: '{cfg['labels']['waiting']}' without a recorded issue to wait for")
                    continue
                other, other_n = marks[-1]
                ref = f'{other}#{other_n}'
                info = gh_json('issue', 'view', other_n, '-R', other, '--json', 'state')
                if info.get('state') == 'CLOSED':
                    if opts.fix:
                        comment(cfg, repo, issue['number'], cfg['texts']['back'].format(ref=ref))
                        relabel(repo, issue['number'], remove=[cfg['labels']['waiting']])
                        fixed.append(f'{tag}: {ref} closed – back in the queue')
                    else:
                        report.append(f'{tag}: {ref} is closed – run check --fix to put it back in the queue')
        done = gh_json('issue', 'list', '-R', repo, '--state', 'closed', '--label', cfg['labels']['working'],
                       '--limit', '100', '--json', 'number')
        for issue in done:
            tag = f"{repo}#{issue['number']}"
            if opts.fix:
                relabel(repo, issue['number'], remove=[cfg['labels']['working']])
                fixed.append(f"{tag}: closed – '{cfg['labels']['working']}' removed")
            else:
                report.append(f"{tag}: closed but still '{cfg['labels']['working']}'")
    for line in fixed:
        print('fixed  ' + line)
    for line in report:
        print('check  ' + line)
    if not fixed and not report:
        print('all consistent')


def cmd_setup(cfg, opts):
    wanted = {cfg['labels'][k]: k for k in ('working', 'question', 'deferred', 'waiting')}
    for repo in cfg['repos']:
        have = {l['name'] for l in gh_json('label', 'list', '-R', repo, '--limit', '200', '--json', 'name')}
        for name in wanted:
            if name not in have:
                gh('label', 'create', name, '-R', repo, '--color', 'BFBFBF', '--description', f'agentq: {wanted[name]}')
                print(f'{repo}: label "{name}" created')
    print('labels ready')


def main(argv=None):
    p = argparse.ArgumentParser(prog='agentq', description='Task queue of an agent team on GitHub issues.')
    p.add_argument('--config', help='config file (default: AGENTQ_CONFIG, the nearest .agentq.json, ~/.config/agentq/config.json)')
    sub = p.add_subparsers(dest='cmd', required=True)
    q = sub.add_parser('queue', help='the queue and the owner\'s new comments')
    q.add_argument('--all', action='store_true', help='also count skipped issues by label')
    q.add_argument('--peek', action='store_true', help='do not move the "since" mark')
    sub.add_parser('take', help='start an issue').add_argument('issue')
    a = sub.add_parser('ask', help='ask the owner; the issue leaves the queue')
    a.add_argument('issue')
    a.add_argument('text')
    d = sub.add_parser('defer', help='the owner deferred it')
    d.add_argument('issue')
    d.add_argument('text', nargs='?')
    w = sub.add_parser('wait', help='wait for an issue in another project')
    w.add_argument('issue')
    w.add_argument('other')
    c = sub.add_parser('check', help='find inconsistent states')
    c.add_argument('--fix', action='store_true')
    sub.add_parser('setup', help='create the labels agentq uses')
    opts = p.parse_args(argv)
    try:
        cfg = load_config(find_config(opts.config))
        {'queue': cmd_queue, 'take': cmd_take, 'ask': cmd_ask, 'defer': cmd_defer,
         'wait': cmd_wait, 'check': cmd_check, 'setup': cmd_setup}[opts.cmd](cfg, opts)
    except Fail as e:
        print(f'agentq: {e}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
