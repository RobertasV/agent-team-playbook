class Fail(Exception):
    pass


# ---------- basics ----------

def now():
    fixed = os.environ.get('AGENTQ_NOW')
    if fixed:
        return parse_time(fixed)
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def parse_time(text):
    return dt.datetime.fromisoformat(text.replace('Z', '+00:00'))


def iso(moment):
    return moment.astimezone(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def gh(*args):
    run = subprocess.run(['gh', *args], capture_output=True, text=True)
    if run.returncode != 0:
        raise Fail(f"gh {' '.join(args[:3])}: {run.stderr.strip() or run.stdout.strip()}")
    return run.stdout


def gh_json(*args):
    out = gh(*args)
    return json.loads(out) if out.strip() else []


def gh_pages(*args):
    """`gh api --paginate` prints one JSON array per page; join them."""
    out, items, at = gh(*args), [], 0
    decoder = json.JSONDecoder()
    while True:
        while at < len(out) and out[at].isspace():
            at += 1
        if at >= len(out):
            return items
        value, at = decoder.raw_decode(out, at)
        items += value if isinstance(value, list) else [value]


def git(checkout, *args):
    run = subprocess.run(['git', '-C', os.path.expanduser(checkout), *args], capture_output=True, text=True)
    if run.returncode != 0:
        raise Fail(f"git {' '.join(args[:2])}: {run.stderr.strip()}")
    return run.stdout


# ---------- config and state ----------

def find_config(explicit):
    """--config, then AGENTQ_CONFIG, then the nearest .agentq.json from here up (the project opted in), then the user default."""
    if explicit:
        return explicit
    if os.environ.get('AGENTQ_CONFIG'):
        return os.environ['AGENTQ_CONFIG']
    here = os.getcwd()
    while True:
        candidate = os.path.join(here, PROJECT_CONFIG)
        if os.path.exists(candidate):
            return candidate
        parent = os.path.dirname(here)
        if parent == here:
            return DEFAULT_CONFIG
        here = parent


def number(text):
    value = float(text)
    return int(value) if value.is_integer() else value


def role_entry(raw):
    role = {'label': raw['role'], 'mode': 'programmer', 'n': 5, 'hours': 24, 'paths': [], 'model': '',
            'release_model': '', 'effort': '', 'hard_effort': '', 'session': '', 'description': '', 'examples': [],
            'shots': [], **raw}
    role.setdefault('merge', role['mode'] == 'programmer')
    if role['mode'] not in MODES:
        raise Fail(f'role {role["role"]}: mode must be one of {", ".join(MODES)}')
    return role


def load_config(path):
    try:
        with open(path, encoding='utf-8') as f:
            raw = json.load(f)
    except FileNotFoundError:
        raise Fail(f'no config at {path} (copy config.example.json there, or pass --config)')
    cfg = copy.deepcopy(raw)
    for key in ('owner_accounts', 'agent_account', 'repos', 'labels'):
        if not cfg.get(key):
            raise Fail(f'config {path}: "{key}" is missing')
    for key in ('working', 'question', 'deferred', 'waiting'):
        if not cfg['labels'].get(key):
            raise Fail(f'config {path}: "labels.{key}" is missing')
    cfg['_raw'], cfg['_path'] = raw, os.path.realpath(path)
    cfg['labels'] = {**DEFAULT_LABELS, **cfg['labels']}
    cfg['texts'] = {**DEFAULT_TEXTS, **cfg.get('texts', {})}
    cfg['roles'] = [role_entry(r) for r in (cfg.get('roles') or DEFAULT_ROLES)]
    names = [r['role'] for r in cfg['roles']]
    cfg['default_role'] = cfg.get('default_role') or ('programmer' if 'programmer' in names else names[0])
    cfg['role'] = cfg.get('role') or cfg['default_role']
    cfg['dispatcher'] = {'name': 'dispatcher', 'folder': '', 'session': '', **cfg.get('dispatcher', {})}
    skip = set(cfg.get('skip_labels', []))
    skip.update(cfg['labels'][k] for k in ('question', 'deferred', 'waiting', 'owner_word', 'health'))
    cfg['skip'] = skip
    cfg['state_file'] = os.path.expanduser(cfg.get('state_file') or cfg['_path'] + '.state.json')
    cfg['stale_hours'] = cfg.get('stale_hours', 24)
    cfg['poll_seconds'] = cfg.get('poll_seconds', 60)
    cfg['watch_grace_minutes'] = cfg.get('watch_grace_minutes', 30)
    cfg['lesson_examples'] = cfg.get('lesson_examples', 5)
    cfg['repeat_minutes'] = cfg.get('repeat_minutes', 30)
    cfg['links'] = [{'repo': l['repo'], 'about': l.get('about', '')} for l in cfg.get('links', [])]
    folder = cfg['dispatcher']['folder']
    cfg['team_dir'] = os.path.expanduser(folder) if folder else os.path.dirname(cfg['state_file'])
    cfg['shots_dir'] = os.path.expanduser(cfg.get('shots_dir') or '~/.cache/agentq/shots')  # never beside a config in a repo
    return cfg


def save_config(cfg, change):
    """Change the raw config (as written by the owner), write it back, return the reloaded config."""
    raw = copy.deepcopy(cfg['_raw'])
    change(raw)
    tmp = cfg['_path'] + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(raw, f, indent=2, ensure_ascii=False)
        f.write('\n')
    os.replace(tmp, cfg['_path'])
    return load_config(cfg['_path'])


def load_state(cfg):
    try:
        with open(cfg['state_file'], encoding='utf-8') as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def save_state(cfg, state):
    tmp = cfg['state_file'] + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, cfg['state_file'])


# ---------- roles ----------

def role_by_name(cfg, name):
    for role in cfg['roles']:
        if role['role'].lower() == name.strip().lower():
            return role
    raise Fail(f'no role "{name}" (roles: {", ".join(r["role"] for r in cfg["roles"])})')


def role_of_labels(cfg, names):
    for role in cfg['roles']:
        if role['label'] in names:
            return role
    return None


def default_role(cfg):
    return role_by_name(cfg, cfg['default_role'])


def checked_label(cfg, role):
    return cfg['labels']['checked'].format(role=role['role'])


def session_of(role):
    """A role session as plans name it: the role, then its id – never the dispatcher's own."""
    return f"{role['role']} ({role['session'] or 'no session id in the config – run setup'})"


# ---------- GitHub helpers ----------

def resolve(cfg, ref):
    m = REF.match(ref.strip())
    if not m:
        raise Fail(f'"{ref}" is not an issue (use N, #N or owner/repo#N)')
    repo = m.group(1) or cfg['repos'][0]
    if repo not in cfg['repos']:
        raise Fail(f'{repo} is not in this config (repos: {", ".join(cfg["repos"])})')
    return repo, int(m.group(2))


def labels_of(issue):
    return [l['name'] for l in issue.get('labels', [])]


def login_of(item):
    who = item.get('author') or item.get('user') or {}
    return who.get('login')


def one_line(text, size=200):
    text = ' '.join(text.split())
    return text if len(text) <= size else text[:size - 1] + '…'


def open_issues(repo):
    return gh_json('issue', 'list', '-R', repo, '--state', 'open', '--limit', '500',
                   '--json', 'number,title,labels,updatedAt,comments')


def board(repo):
    """The open issues without their comments: cheap enough to read every minute."""
    return gh_json('issue', 'list', '-R', repo, '--state', 'open', '--limit', '500',
                   '--json', 'number,title,labels,author,createdAt,updatedAt')


def view(repo, number):
    return gh_json('issue', 'view', str(number), '-R', repo, '--json', 'number,title,body,labels,state,author')


def comment(cfg, repo, number, text, who=None):
    body = f"🤖 {who or cfg['role']}: {text}"
    gh('issue', 'comment', str(number), '-R', repo, '--body', body)


def relabel(repo, number, add=(), remove=()):
    args = ['issue', 'edit', str(number), '-R', repo]
    for name in add:
        args += ['--add-label', name]
    for name in remove:
        args += ['--remove-label', name]
    if len(args) > 5:
        gh(*args)


def create_issue(repo, title, body, labels):
    args = ['issue', 'create', '-R', repo, '--title', title, '--body', body]
    for name in labels:
        args += ['--label', name]
    url = gh(*args).strip().splitlines()[-1]
    m = re.search(r'/issues/(\d+)$', url)
    if not m:
        raise Fail(f'gh issue create printed no issue link: {url}')
    return int(m.group(1))


def holder(cfg, issue):
    """Who writes on this issue: the role whose label it carries, else the session's own role."""
    role = role_of_labels(cfg, labels_of(issue))
    return role['role'] if role else cfg['role']


def trusted(cfg, issue):
    if cfg.get('accept_issues_from_others'):
        return True
    return login_of(issue) in set(cfg['owner_accounts']) | {cfg['agent_account']}


# ---------- 0.1 commands ----------

def cmd_queue(cfg, opts):
    state = load_state(cfg)
    started = now()
    lines = []
    for repo in cfg['repos']:
        since = state.get(repo, {}).get('last')
        issues = open_issues(repo)
        if since is None:
            lines.append(f'{repo}: first run – owner comments from now on will be shown.')
        else:
            since_t = parse_time(since)
            news = []
            for issue in issues:
                for c in issue.get('comments', []):
                    if c['author']['login'] in cfg['owner_accounts'] and parse_time(c['createdAt']) > since_t:
                        news.append(f"  {repo}#{issue['number']} {one_line(issue['title'], 60)}: {one_line(c['body'])}")
            lines.append(f'{repo}: owner comments since {since}: {len(news) or "none"}')
            lines.extend(news)
        working, todo, skipped = [], [], {}
        for issue in sorted(issues, key=lambda i: i['number']):
            names = labels_of(issue)
            hit = [n for n in names if n in cfg['skip']]
            row = f"  {repo}#{issue['number']} [{', '.join(names)}] {one_line(issue['title'], 100)}"
            if cfg['labels']['working'] in names:
                working.append(row)
            elif hit:
                for n in hit:
                    skipped[n] = skipped.get(n, 0) + 1
            else:
                todo.append(row)
        if working:
            lines.append(f'{repo}: in progress ({len(working)}):')
            lines.extend(working)
        lines.append(f'{repo}: queue ({len(todo)}):')
        lines.extend(todo)
        if opts.all and skipped:
            lines.append('  skipped: ' + ', '.join(f'{k} {v}' for k, v in sorted(skipped.items())))
        state.setdefault(repo, {})['last'] = iso(started)
    print('\n'.join(lines))
    if not opts.peek:
        save_state(cfg, state)


def cmd_take(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    comment(cfg, repo, number, cfg['texts']['take'], holder(cfg, view(repo, number)))
    relabel(repo, number, add=[cfg['labels']['working']])
    print(f'{repo}#{number}: taken')


def ask_owner(cfg, repo, number, text, who):
    comment(cfg, repo, number, cfg['texts']['ask'].format(text=text), who)
    relabel(repo, number, add=[cfg['labels']['question']], remove=[cfg['labels']['working']])


def cmd_ask(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    ask_owner(cfg, repo, number, opts.text, holder(cfg, view(repo, number)))
    print(f'{repo}#{number}: asked the owner, out of the queue')


def cmd_defer(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    who = holder(cfg, view(repo, number))
    comment(cfg, repo, number, cfg['texts']['defer'].format(text=opts.text or '').strip(), who)
    relabel(repo, number, add=[cfg['labels']['deferred']], remove=[cfg['labels']['working']])
    print(f'{repo}#{number}: deferred')


def cmd_wait(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    m = re.match(r'^([\w.-]+/[\w.-]+)#(\d+)$', opts.other.strip())
    if not m:
        raise Fail(f'"{opts.other}" must be owner/repo#N')
    ref = f'{m.group(1)}#{m.group(2)}'
    text = cfg['texts']['wait'].format(ref=ref) + f'\n<!-- agentq:wait {ref} -->'
    comment(cfg, repo, number, text, holder(cfg, view(repo, number)))
    relabel(repo, number, add=[cfg['labels']['waiting']], remove=[cfg['labels']['working']])
    print(f'{repo}#{number}: waits for {ref}')


def cmd_check(cfg, opts):
    moment = now()
    stale = dt.timedelta(hours=cfg['stale_hours'])
    report, fixed = [], []
    for repo in cfg['repos']:
        for issue in open_issues(repo):
            names = labels_of(issue)
            tag = f"{repo}#{issue['number']}"
            comments = issue.get('comments', [])
            if cfg['labels']['working'] in names and moment - parse_time(issue['updatedAt']) > stale:
                report.append(f"{tag}: '{cfg['labels']['working']}' but nothing happened for over {cfg['stale_hours']} h")
            if comments and comments[-1]['author']['login'] in cfg['owner_accounts']:
                report.append(f"{tag}: the owner's comment waits for an answer – {one_line(comments[-1]['body'], 120)}")
            if cfg['labels']['waiting'] in names:
                marks = [m for c in comments for m in WAIT_MARK.findall(c.get('body', ''))]
                if not marks:
                    report.append(f"{tag}: '{cfg['labels']['waiting']}' without a recorded issue to wait for")
                    continue
                other, other_n = marks[-1]
                ref = f'{other}#{other_n}'
                info = gh_json('issue', 'view', other_n, '-R', other, '--json', 'state')
                if info.get('state') == 'CLOSED':
                    if opts.fix:
                        comment(cfg, repo, issue['number'], cfg['texts']['back'].format(ref=ref))
                        relabel(repo, issue['number'], remove=[cfg['labels']['waiting']])
                        fixed.append(f'{tag}: {ref} closed – back in the queue')
                    else:
                        report.append(f'{tag}: {ref} is closed – run check --fix to put it back in the queue')
        done = gh_json('issue', 'list', '-R', repo, '--state', 'closed', '--label', cfg['labels']['working'],
                       '--limit', '100', '--json', 'number')
        for issue in done:
            tag = f"{repo}#{issue['number']}"
            if opts.fix:
                relabel(repo, issue['number'], remove=[cfg['labels']['working']])
                fixed.append(f"{tag}: closed – '{cfg['labels']['working']}' removed")
            else:
                report.append(f"{tag}: closed but still '{cfg['labels']['working']}'")
    for line in fixed:
        print('fixed  ' + line)
    for line in report:
        print('check  ' + line)
    if not fixed and not report:
        print('all consistent')


# ---------- the watcher and its plan ----------

def busy_with(cfg, issues, role, but=None):
    working = cfg['labels']['working']
    return [i for i in issues if i['number'] != but and role['label'] in labels_of(i) and working in labels_of(i)]


def next_issue(cfg, issues, role):
    """Priority label → blocking label → oldest."""
    skip = cfg['skip'] | {cfg['labels']['working'], cfg['labels']['batch']}
    queue = [i for i in issues if role['label'] in labels_of(i) and not skip & set(labels_of(i)) and trusted(cfg, i)]
    queue.sort(key=lambda i: (cfg['labels']['priority'] not in labels_of(i),
                              cfg['labels']['blocking'] not in labels_of(i), i['number']))
    return queue[0] if queue else None


def path_hit(name, patterns):
    for p in patterns:
        p = p.rstrip('/')
        if name == p or name.startswith(p + '/') or fnmatch.fnmatch(name, p):
            return True
    return False


def touched(cfg, items, patterns):
    """Only the tasks whose commits (found by "#N" in the message, local git log) changed these paths."""
    if not items:
        return []
    if not cfg.get('checkout'):
        raise Fail('a path filter needs "checkout" (the project folder) in the config')
    numbers = {i['number'] for i in items}
    grep = '#(' + '|'.join(str(n) for n in sorted(numbers)) + ')([^0-9]|$)'
    out = git(cfg['checkout'], 'log', '--all', '-E', f'--grep={grep}', '--format=%x1e%B%x1f', '--name-only')
    hit = set()
    for chunk in out.split('\x1e')[1:]:
        message, _, files = chunk.partition('\x1f')
        refs = {int(n) for n in re.findall(r'#(\d+)\b', message)} & numbers
        if any(path_hit(f.strip(), patterns) for f in files.splitlines() if f.strip()):
            hit |= refs
    return [i for i in items if i['number'] in hit]


def unchecked(cfg, state, repo, role, cache):
    """Finished tasks this checker-mode role has not checked yet, oldest first."""
    since = role.get('since') or state.setdefault('checker_since', {}).setdefault(role['role'], iso(now()))
    if repo not in cache:
        first = min([since] + [r.get('since') or since for r in cfg['roles'] if r['mode'] == 'checker'])
        cache[repo] = gh_json('issue', 'list', '-R', repo, '--state', 'closed', '--limit', '300',
                              '--search', f'closed:>={first}',
                              '--json', 'number,title,labels,closedAt,stateReason,author')
    not_tasks = {checked_label(cfg, role), cfg['labels']['batch'], cfg['labels']['health']}
    items = [i for i in cache[repo]
             if parse_time(i['closedAt']) >= parse_time(since) and i.get('stateReason') != 'NOT_PLANNED'
             and not not_tasks & set(labels_of(i)) and trusted(cfg, i)]
    if role['paths']:
        items = touched(cfg, items, role['paths'])
    return sorted(items, key=lambda i: i['closedAt'])


def batch_ready(cfg, role, items, moment):
    if not items:
        return False
    return len(items) >= int(role['n']) or moment - parse_time(items[0]['closedAt']) >= dt.timedelta(hours=float(role['hours']))


def build_plan(cfg, state, start):
    """Read the board; return the steps for the dispatcher. Moves the marks in `state`."""
    owners = set(cfg['owner_accounts'])
    labels = cfg['labels']
    plan = []
    for repo in cfg['repos']:
        mine = state.setdefault(repo, {})
        first = 'watch_mark' not in mine
        seen = mine.setdefault('seen', {})
        issues = board(repo)
        taken = set()
        window = iso(start - OVERLAP)
        news = {}
        for item in gh_json('issue', 'list', '-R', repo, '--state', 'all', '--limit', '100',
                            '--search', f'updated:>={window}', '--json', 'number,title,labels,state,comments'):
            for c in item.get('comments', []):
                key = c.get('id') or c.get('url') or f"{login_of(c)}@{c['createdAt']}"
                at = parse_time(c['createdAt'])
                if login_of(c) not in owners or key in seen or not start - OVERLAP <= at <= start:
                    continue
                seen[key] = c['createdAt']
                if not first:
                    news.setdefault(item['number'], (item, []))[1].append(c['createdAt'])
        for key in [k for k, at in seen.items() if parse_time(at) < start - 2 * OVERLAP]:
            del seen[key]
        mine['watch_mark'] = iso(start)
        for number, (item, times) in sorted(news.items()):
            names = labels_of(item)
            role = role_of_labels(cfg, names)
            ref = f'{repo}#{number}'
            is_open = item.get('state', 'OPEN') == 'OPEN'
            if is_open and labels['question'] in names:
                role = role or default_role(cfg)
                plan.append(('answered', ref, role, item['title'], None))
                taken.add(role['role'])
            elif not is_open or (role and (labels['working'] in names or cfg['skip'] & set(names))) \
                    or (not role and (labels['working'] in names or cfg['skip'] & set(names))):
                plan.append(('forward', ref, role or default_role(cfg), item['title'], min(times)))
            # an open issue without a role is classified below; a queued one carries the words in its brief
        cache = {}
        for role in cfg['roles']:
            if role['role'] in taken or busy_with(cfg, issues, role):
                continue
            issue = next_issue(cfg, issues, role)
            if issue:
                plan.append(('assign', f"{repo}#{issue['number']}", role, issue['title'], None))
            elif role['mode'] == 'checker' and batch_ready(cfg, role, unchecked(cfg, state, repo, role, cache), start):
                plan.append(('batch', repo, role, None, None))
        skip = cfg['skip'] | {labels['working'], labels['batch']}
        loose = [i for i in sorted(issues, key=lambda i: i['number'])
                 if not role_of_labels(cfg, labels_of(i)) and not skip & set(labels_of(i)) and trusted(cfg, i)]
        for issue in loose[:10]:
            plan.append(('classify', f"{repo}#{issue['number']}", None, issue['title'], None))
    return plan


def render_plan(cfg, plan, start):
    q = 'agentq'
    lines = [f'agentq plan {iso(start)} – do each step in order:']
    for n, (kind, ref, role, title, since) in enumerate(plan, 1):
        if kind == 'forward':
            lines.append(f'{n}. the owner wrote on {ref} ({role["role"]}): send the output of '
                         f'`{q} brief {ref} --since {since}` to {session_of(role)}.')
        elif kind == 'answered':
            lines.append(f'{n}. the owner answered on {ref}: run `{q} assign {ref} {role["role"]}` and do what it prints.')
        elif kind == 'assign':
            lines.append(f'{n}. next task for {role["role"]}: run `{q} assign {ref} {role["role"]}` and do what it prints.')
        elif kind == 'batch':
            lines.append(f'{n}. a batch is ready for {role["role"]}: run `{q} batch {role["role"]} -R {ref}` '
                         f'and do what it prints.')
        else:
            moving = (f' If all of it belongs to a linked project in roles.md, run `{q} move {ref} <owner/repo>` '
                      f'instead.') if cfg['links'] else ''
            lines.append(f'{n}. classify {ref} "{one_line(title, 80)}": pick a role (roles.md; unsure → '
                         f'{cfg["default_role"]}), run `{q} assign {ref} <role>` and do what it prints.{moving}')
    lines.append(f'Last: start `{q} watch` again in the background.')
    return '\n'.join(lines)


def watch_lock(cfg):
    handle = open(cfg['state_file'] + '.watch.lock', 'a')
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None
    return handle


def cmd_watch(cfg, opts):
    lock = watch_lock(cfg)
    if lock is None:
        print('agentq watch: already running – nothing to do.')
        return 0
    interval = cfg['poll_seconds'] if opts.interval is None else opts.interval
    while True:
        state = load_state(cfg)
        start = now()
        work = copy.deepcopy(state)
        if state.get('paused'):  # the team is paused: stay alive, send nothing
            state['watch'] = {**state.get('watch', {}), 'pid': os.getpid(), 'beat': iso(start)}
            state['watch'].pop('error', None)
            save_state(cfg, state)
            if opts.once:
                print(f"agentq watch: paused since {state['paused']['at']} – {state['paused']['why']}")
                return 0
            time.sleep(interval)
            continue
        try:
            plan = build_plan(cfg, work, start)
        except Fail as e:
            state['watch'] = {'pid': os.getpid(), 'beat': iso(start), 'error': str(e)}
            save_state(cfg, state)
            if opts.once:
                raise
        else:
            last = state.get('watch', {})
            text = render_plan(cfg, plan, start) if plan else ''
            body = text.split('\n', 1)[-1]
            work['watch'] = {'pid': os.getpid(), 'beat': iso(start), 'plan': last.get('plan'), 'sent': last.get('sent')}
            if plan and body == last.get('plan') and start - parse_time(last['sent']) < dt.timedelta(minutes=cfg['repeat_minutes']):
                plan = None  # the dispatcher did not act on this plan: do not wake it every minute for it
            elif plan:
                work['watch'].update(exited=iso(start), plan=body, sent=iso(start))
            save_state(cfg, work)
            if plan:
                print(text)
                return 0
            if opts.once:
                print('agentq watch: no work.')
                return 0
        time.sleep(interval)


# ---------- dispatcher commands ----------

def session_settings(cfg, state, role, issue_labels, batch):
    """The model and effort this task needs; a line for each that differs from what was last set."""
    want = {'model': role['model'], 'effort': role['effort']}
    if role['mode'] == 'checker' and not batch and role['release_model']:
        want['model'] = role['release_model']
    if cfg['labels']['hard'] in issue_labels and role['hard_effort']:
        want['effort'] = role['hard_effort']
    last = state.setdefault('sessions', {}).setdefault(role['role'], {})
    lines = []
    for key, tool in (('model', 'set_session_model'), ('effort', 'set_session_effort')):
        if want[key] and want[key] != last.get(key):
            lines.append(f'{tool} for {session_of(role)}: {want[key]}')
            last[key] = want[key]
    return lines


def print_send(cfg, state, role, ref, issue_labels, batch=False):
    steps = session_settings(cfg, state, role, issue_labels, batch)
    steps.append(f'send the output of `agentq brief {ref}` to {session_of(role)}')
    for n, step in enumerate(steps, 1):
        print(f'{n}. {step}')


def cmd_assign(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    role = role_by_name(cfg, opts.role)
    issue = view(repo, number)
    names = labels_of(issue)
    labels = cfg['labels']
    remove = [r['label'] for r in cfg['roles'] if r is not role and r['label'] in names]
    ref = f'{repo}#{number}'
    if opts.queue:  # sorting: the role label only; skip labels (question, deferred, …) stay
        relabel(repo, number, add=[role['label']], remove=remove)
        print(f"{ref} → {role['role']}, in its queue")
        return
    remove += [labels['question']] if labels['question'] in names else []  # the owner answered
    busy = busy_with(cfg, board(repo), role, but=number)
    who = cfg['dispatcher']['name']
    if busy:
        comment(cfg, repo, number, cfg['texts']['queued'].format(role=role['role']), who)
        relabel(repo, number, add=[role['label']], remove=remove)
        print(f"{ref} → {role['role']}, queued ({role['role']} works on #{busy[0]['number']}). Nothing to send.")
        return
    comment(cfg, repo, number, cfg['texts']['assign'].format(role=role['role']), who)
    relabel(repo, number, add=[role['label'], labels['working']], remove=remove)
    print(f"{ref} → {role['role']}, working. Now:")
    state = load_state(cfg)
    print_send(cfg, state, role, ref, names, batch=labels['batch'] in names)
    save_state(cfg, state)


def shot_name(url, kind, n):
    ext = {'image/png': '.png', 'image/jpeg': '.jpg', 'image/gif': '.gif', 'image/webp': '.webp'}.get(kind)
    if not ext:
        ext = os.path.splitext(urllib.parse.urlparse(url).path)[1][:5] or '.img'
    return f'shot-{n}{ext}'


def repo_file(match):
    """A file in a (maybe private) repository, read through gh as the AI account."""
    owner, repo, ref, path = [g for g in match.groups() if g is not None]
    path = urllib.parse.quote(urllib.parse.unquote(path))
    run = subprocess.run(['gh', 'api', f'repos/{owner}/{repo}/contents/{path}?ref={ref}', '-H',
                          'Accept: application/vnd.github.raw'], capture_output=True)
    if run.returncode != 0:
        raise OSError(f'the AI account cannot read {owner}/{repo} (the owner invites it with Read access)')
    return run.stdout


def download_shots(rendered, folder, first):
    """Uploaded images have short-lived signed links in GitHub's rendered HTML that need no login, even in private
    repos; an image linked from a repository is read through gh."""
    paths = []
    for n, src in enumerate((html.unescape(s) for s in IMG.findall(rendered or '')), first):
        if urllib.parse.urlparse(src).scheme not in ('https', 'file'):  # file: only in tests
            continue
        try:
            in_repo = REPO_FILE.match(src)
            if in_repo:
                data, kind = repo_file(in_repo), ''
            else:
                with urllib.request.urlopen(src, timeout=30) as r:
                    data, kind = r.read(), (r.headers.get('Content-Type') or '').split(';')[0]
            os.makedirs(folder, exist_ok=True)
            path = os.path.join(folder, shot_name(src, kind, n))
            with open(path, 'wb') as f:
                f.write(data)
            paths.append(path)
        except OSError as e:
            paths.append(f'(could not download screenshot {n}: {e})')
    return paths


def cmd_brief(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    ref = f'{repo}#{number}'
    issue = gh_json('api', f'repos/{repo}/issues/{number}', '-H', FULL)
    comments = gh_pages('api', f'repos/{repo}/issues/{number}/comments', '-H', FULL, '--paginate')
    owners = set(cfg['owner_accounts'])
    since = parse_time(opts.since) if opts.since else None
    picked = [c for c in comments if login_of(c) in owners and (since is None or parse_time(c['created_at']) >= since)]
    names = labels_of(issue)
    role = role_of_labels(cfg, names) or default_role(cfg)
    folder = os.path.join(cfg['shots_dir'], repo.replace('/', '-'), str(number))
    texts = cfg['texts']
    out = [(texts['brief_news'] if since else texts['brief_head']).format(ref=ref, role=role['role']),
           f"Title: {issue['title']}"]
    shots = []
    if not since:
        author = login_of(issue)
        tag = 'the owner' if author in owners else 'an agent' if author == cfg['agent_account'] else 'NOT the owner'
        out += [f'Labels: {", ".join(names) or "none"}', f'--- issue text by {author} ({tag}) ---',
                (issue.get('body') or '(empty)').strip()]
        shots += download_shots(issue.get('body_html'), folder, 1)
    handover = [c for c in comments if login_of(c) == cfg['agent_account'] and ROUTE_MARK in (c.get('body') or '')]
    if handover and not since:  # the note of the role that handed it over (e.g. "merge branch …")
        c = handover[-1]
        out += [f"--- handed over, {c['created_at']} ---", c['body'].replace(ROUTE_MARK, '').strip()]
    for c in picked:
        out += [f"--- the owner ({login_of(c)}), {c['created_at']} ---", (c.get('body') or '').strip()]
        shots += download_shots(c.get('body_html'), folder, len(shots) + 1)
    if shots:
        out.append('--- screenshots, in order, as local files ---')
        out += shots
    if not since:
        batch = BATCH_MARK.search(issue.get('body') or '')
        finish = 'finish_batch' if batch else 'finish' if role['merge'] else 'finish_handoff'
        out += ['---', texts[finish].format(ref=ref, number=number, default=cfg['default_role'])]
        if cfg['links'] and not batch:
            out.append(texts['finish_links'].format(ref=ref))
    print('\n'.join(out))


# ---------- lessons, rules, routing ----------

def lessons_path(cfg):
    return os.path.join(cfg['team_dir'], 'lessons.json')


def load_lessons(cfg):
    try:
        with open(lessons_path(cfg), encoding='utf-8') as f:
            data = json.load(f)
    except FileNotFoundError:
        data = {}
    return {'rules': data.get('rules', []), 'examples': data.get('examples', {})}


def render_roles(cfg, lessons):
    lines = ['# Roles', '',
             'Written by agentq from the config, `agentq route` and `agentq teach`. Do not edit by hand.', '']
    for role in cfg['roles']:
        extra = ' (default: when unsure)' if role['role'] == cfg['default_role'] else ''
        lines.append(f"## {role['role']}{extra}")
        mode = role['mode'] + (f", batches of {role['n']} or {role['hours']} h" if role['mode'] == 'checker' else '')
        lines.append(f"Label `{role['label']}`, {mode}." + (f" Paths: {', '.join(role['paths'])}." if role['paths'] else ''))
        if role['description']:
            lines.append(role['description'])
        lines += [f'- e.g. {e}' for e in role['examples']]
        lines += [f'- reference screenshot: examples/{name}' for name in role['shots']]
        routed = lessons['examples'].get(role['role'], [])
        if routed:
            lines.append('Routed here by a role that got it by mistake:')
            lines += [f"- {e['issue']} {e['title']} (not {e['from']})" for e in routed]
        lines.append('')
    if cfg['links']:
        lines.append('## Linked projects (sharing on)')
        lines.append('A task that belongs wholly to one of these moves there; a mixed one goes to the default role.')
        lines += [f"- {l['repo']}: {l['about']}" for l in cfg['links']]
        moved = lessons['examples'].get('@moved', [])
        if moved:
            lines.append('Moved there by a role after it came here:')
            lines += [f"- {e['issue']} {e['title']} → {e['to']}" for e in moved]
        lines.append('')
    lines.append('## Rules')
    lines += [f"- {r['text']} ({r['by']})" for r in lessons['rules']] or ['- none yet']
    return '\n'.join(lines) + '\n'


def save_lessons(cfg, lessons):
    os.makedirs(cfg['team_dir'], exist_ok=True)
    tmp = lessons_path(cfg) + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(lessons, f, indent=2, ensure_ascii=False)
    os.replace(tmp, lessons_path(cfg))
    write_roles(cfg, lessons)


def write_roles(cfg, lessons=None):
    os.makedirs(cfg['team_dir'], exist_ok=True)
    with open(os.path.join(cfg['team_dir'], 'roles.md'), 'w', encoding='utf-8') as f:
        f.write(render_roles(cfg, lessons or load_lessons(cfg)))


def cmd_route(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    target = role_by_name(cfg, opts.role)
    issue = view(repo, number)
    names = labels_of(issue)
    old = role_of_labels(cfg, names)
    who = old['role'] if old else cfg['role']
    remove = [r['label'] for r in cfg['roles'] if r is not target and r['label'] in names]
    remove += [cfg['labels']['working']] if cfg['labels']['working'] in names else []
    text = cfg['texts']['route'].format(role=target['role'], text=opts.text or '').strip()
    comment(cfg, repo, number, f'{text}\n{ROUTE_MARK}', who)
    relabel(repo, number, add=[target['label']], remove=remove)
    print(f"{repo}#{number} → {target['role']}")
    if opts.no_lesson or (old and old is target):
        return
    lessons = load_lessons(cfg)
    examples = lessons['examples'].setdefault(target['role'], [])
    examples.append({'issue': f'#{number}', 'title': one_line(issue['title'], 100), 'from': who})
    del examples[:-int(cfg['lesson_examples'])]
    save_lessons(cfg, lessons)
    print(f"lesson recorded for the dispatcher: #{number} is {target['role']}'s, not {who}'s")


def rule_role(cfg, rest):
    """The role a rule points to: the role name it starts with; anything after it is a note ("designer (writes only)")."""
    hits = [r['role'] for r in cfg['roles'] if re.match(rf'{re.escape(r["role"])}(?!\w)', rest.strip(), re.I)]
    if not hits:
        raise Fail(f'"{rest}" does not start with a role (roles: {", ".join(r["role"] for r in cfg["roles"])}); '
                   f'write "topic → role", a note may follow the role')
    return max(hits, key=len)


def cmd_teach(cfg, opts):
    text = ' '.join(opts.rule.split())
    by = 'owner' if opts.owner else 'agent'
    parts = ARROW.split(text, maxsplit=1)
    topic, role = (parts[0].lower(), rule_role(cfg, parts[1])) if len(parts) == 2 else (None, None)
    if role:
        text = f'{parts[0]} → {parts[1]}'
    lessons = load_lessons(cfg)
    rules = lessons['rules']
    same = [r for r in rules if (topic and r.get('topic') == topic) or r['text'].lower() == text.lower()]
    clash = next((r for r in same if r.get('role') != role), None)
    known = next((r for r in same if r.get('role') == role), None)
    if known and not clash:
        if by == 'owner' and known['by'] != 'owner':
            known['by'] = 'owner'
            save_lessons(cfg, lessons)
        print(f'already a rule: {known["text"]}')
        return
    if clash and by == 'owner' and clash['by'] != 'owner':
        rules.remove(clash)
        print(f'the owner\'s rule replaces "{clash["text"]}"')
    elif clash and by != 'owner' and clash['by'] == 'owner':
        print(f'not written: the owner\'s rule stands – "{clash["text"]}". If it looks wrong, ask the owner.')
        return
    elif clash:
        question = cfg['texts']['rule_question'].format(old=clash['text'], old_by=clash['by'], new=text, new_by=by)
        if opts.issue:
            repo, number = resolve(cfg, opts.issue)
            ask_owner(cfg, repo, number, question, cfg['role'])
            print(f'not written: the rules disagree – asked the owner on {repo}#{number}')
        else:
            repo = cfg['repos'][0]
            number = create_issue(repo, cfg['texts']['rule_title'].format(topic=topic),
                                  f"🤖 {cfg['role']}: {question}", [cfg['labels']['question']])
            print(f'not written: the rules disagree – asked the owner in {repo}#{number}')
        return
    rules.append({'text': text, 'topic': topic, 'role': role, 'by': by, 'at': iso(now())})
    save_lessons(cfg, lessons)
    print(f'rule written: {text} ({by})')


def linked(cfg, repo):
    if repo not in [l['repo'] for l in cfg['links']]:
        raise Fail(f'{repo} is not a linked project (links: {", ".join(l["repo"] for l in cfg["links"]) or "none"}; '
                   f'agentq link adds one)')
    return repo


def cmd_move(cfg, opts):
    """All of it belongs to a linked project: transfer the issue there (or copy and close when GitHub refuses)."""
    repo, number = resolve(cfg, opts.issue)
    target = linked(cfg, opts.repo)
    issue = view(repo, number)
    names = labels_of(issue)
    owner = role_of_labels(cfg, names)  # no role label: the dispatcher is classifying it
    who = owner['role'] if owner else cfg['dispatcher']['name']
    ref = f'{repo}#{number}'
    comment(cfg, repo, number, cfg['texts']['moved'].format(repo=target, text=opts.text or '').strip(), who)
    ours = [r['label'] for r in cfg['roles']] + [cfg['labels']['working']]
    relabel(repo, number, remove=[n for n in names if n in ours])
    try:
        url = gh('issue', 'transfer', str(number), target, '-R', repo).strip().splitlines()[-1]
    except Fail:
        body = f"{cfg['texts']['moved_copy'].format(ref=ref)}\n\n{issue.get('body') or ''}"
        new = create_issue(target, issue['title'], body, [])
        gh('issue', 'close', str(number), '-R', repo, '--reason', 'not planned', '--comment', f'🤖 {who}: → {target}#{new}')
        url = f'{target}#{new}'
    print(f'{ref} → {url}')
    if owner and not opts.no_lesson:
        lessons = load_lessons(cfg)
        moved = lessons['examples'].setdefault('@moved', [])
        moved.append({'issue': f'#{number}', 'title': one_line(issue['title'], 100), 'to': target})
        del moved[:-int(cfg['lesson_examples'])]
        save_lessons(cfg, lessons)
        print(f'lesson recorded for the dispatcher: #{number} belonged to {target}')


def cmd_split(cfg, opts):
    """A part belongs to a linked project: a new issue there that links back; this one stays."""
    repo, number = resolve(cfg, opts.issue)
    target = linked(cfg, opts.repo)
    ref = f'{repo}#{number}'
    who = holder(cfg, view(repo, number))
    body = f"🤖 {who}: {opts.text}\n\n{cfg['texts']['split_from'].format(ref=ref)}"
    new = create_issue(target, opts.title, body, [])
    comment(cfg, repo, number, cfg['texts']['split'].format(repo=target, other=f'{target}#{new}'), who)
    print(f'{target}#{new} created from {ref}; {ref} stays here')


def cmd_link(cfg, opts):
    """Sharing between projects: add, change or remove a linked project in this project's config."""
    def change(raw):
        links = [l for l in raw.get('links', []) if l['repo'] != opts.repo]
        if not opts.remove:
            if not re.match(r'^[\w.-]+/[\w.-]+$', opts.repo):
                raise Fail(f'"{opts.repo}" must be owner/repo')
            if not opts.about:
                raise Fail('say what belongs there, e.g. "the website: pages, blog, SEO"')
            links.append({'repo': opts.repo, 'about': opts.about})
        raw['links'] = links
    cfg = save_config(cfg, change)
    write_roles(cfg)
    for l in cfg['links']:
        print(f"{l['repo']}: {l['about']}")
    if not cfg['links']:
        print('no linked projects: sharing is off')


def cmd_pause(cfg, opts):
    """Pause the team: the watcher keeps running but plans nothing until `agentq resume`."""
    state = load_state(cfg)
    state['paused'] = {'at': iso(now()), 'why': opts.text or 'no reason given'}
    save_state(cfg, state)
    print(f"paused: the dispatcher gets no work until `agentq resume` ({state['paused']['why']})")


def cmd_resume(cfg, opts):
    state = load_state(cfg)
    was = state.pop('paused', None)
    save_state(cfg, state)
    print('resumed: the watcher plans again from its next poll' if was else 'was not paused')


def cmd_roles(cfg, opts):
    print(render_roles(cfg, load_lessons(cfg)), end='')


