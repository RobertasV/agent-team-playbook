        if not m:
            raise Fail(f'cannot tell the GitHub repository from "{url}" (pass --repo owner/name)')
        repo = m.group(1)
    path = os.path.expanduser(opts.config or f"~/.config/agentq/{repo.replace('/', '-')}.json")
