def lessons_path(cfg):
    return os.path.join(cfg['team_dir'], 'lessons.json')


def load_lessons(cfg):
    try:
        with open(lessons_path(cfg), encoding='utf-8') as f:
            data = json.load(f)
    except FileNotFoundError:
        data = {}
    return {'rules': data.get('rules', []), 'examples': data.get('examples', {})}


def render_roles(cfg, lessons):
    lines = ['# Roles', '',
             'Written by agentq from the config, `agentq route` and `agentq teach`. Do not edit by hand.', '']
    for role in cfg['roles']:
        extra = ' (default: when unsure)' if role['role'] == cfg['default_role'] else ''
        lines.append(f"## {role['role']}{extra}")
        mode = role['mode'] + (f", batches of {role['n']} or {role['hours']} h" if role['mode'] == 'checker' else '')
        lines.append(f"Label `{role['label']}`, {mode}." + (f" Paths: {', '.join(role['paths'])}." if role['paths'] else ''))
        if role['description']:
            lines.append(role['description'])
        lines += [f'- e.g. {e}' for e in role['examples']]
        lines += [f'- reference screenshot: examples/{name}' for name in role['shots']]
        routed = lessons['examples'].get(role['role'], [])
        if routed:
            lines.append('Routed here by a role that got it by mistake:')
            lines += [f"- {e['issue']} {e['title']} (not {e['from']})" for e in routed]
        lines.append('')
    if cfg['links']:
        lines.append('## Linked projects (sharing on)')
        lines.append('A task that belongs wholly to one of these moves there; a mixed one goes to the default role.')
        lines += [f"- {l['repo']}: {l['about']}" for l in cfg['links']]
        moved = lessons['examples'].get('@moved', [])
        if moved:
            lines.append('Moved there by a role after it came here:')
            lines += [f"- {e['issue']} {e['title']} → {e['to']}" for e in moved]
        lines.append('')
    lines.append('## Rules')
    names = {r['role'] for r in cfg['roles']}
    lines += [f"- {r['text']} ({r['by']})" for r in lessons['rules'] if r.get('role') in names | {None}] or ['- none yet']
    return '\n'.join(lines) + '\n'


def save_lessons(cfg, lessons):
    os.makedirs(cfg['team_dir'], exist_ok=True)
    tmp = lessons_path(cfg) + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(lessons, f, indent=2, ensure_ascii=False)
    os.replace(tmp, lessons_path(cfg))
    write_roles(cfg, lessons)


def write_roles(cfg, lessons=None):
    os.makedirs(cfg['team_dir'], exist_ok=True)
    with open(os.path.join(cfg['team_dir'], 'roles.md'), 'w', encoding='utf-8') as f:
        f.write(render_roles(cfg, lessons or load_lessons(cfg)))


def cmd_route(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    target = role_by_name(cfg, opts.role)
    issue = view(repo, number)
    names = labels_of(issue)
    old = role_of_labels(cfg, names)
    who = old['role'] if old else cfg['role']
    remove = [r['label'] for r in cfg['roles'] if r is not target and r['label'] in names]
    remove += [cfg['labels']['working']] if cfg['labels']['working'] in names else []
    text = cfg['texts']['route'].format(role=target['role'], text=opts.text or '').strip()
    comment(cfg, repo, number, f'{text}\n{ROUTE_MARK}', who)
    relabel(repo, number, add=[target['label']], remove=remove)
    print(f"{repo}#{number} → {target['role']}")
    if opts.no_lesson or (old and old is target):
        return
    lessons = load_lessons(cfg)
    examples = lessons['examples'].setdefault(target['role'], [])
    examples.append({'issue': f'#{number}', 'title': one_line(issue['title'], 100), 'from': who})
    del examples[:-int(cfg['lesson_examples'])]
    save_lessons(cfg, lessons)
    print(f"lesson recorded for the dispatcher: #{number} is {target['role']}'s, not {who}'s")


def rule_role(cfg, rest):
    """The role a rule points to: the role name it starts with; anything after it is a note ("designer (writes only)")."""
    hits = [r['role'] for r in cfg['roles'] if re.match(rf'{re.escape(r["role"])}(?!\w)', rest.strip(), re.I)]
    if not hits:
        raise Fail(f'"{rest}" does not start with a role (roles: {", ".join(r["role"] for r in cfg["roles"])}); '
                   f'write "topic → role", a note may follow the role')
    return max(hits, key=len)


def cmd_teach(cfg, opts):
    text = ' '.join(opts.rule.split())
    by = 'owner' if opts.owner else 'agent'
    parts = ARROW.split(text, maxsplit=1)
    topic, role = (parts[0].lower(), rule_role(cfg, parts[1])) if len(parts) == 2 else (None, None)
    if role:
        text = f'{parts[0]} → {parts[1]}'
    lessons = load_lessons(cfg)
    rules = lessons['rules']
    same = [r for r in rules if (topic and r.get('topic') == topic) or r['text'].lower() == text.lower()]
    clash = next((r for r in same if r.get('role') != role), None)
    known = next((r for r in same if r.get('role') == role), None)
    if known and not clash:
        if by == 'owner' and known['by'] != 'owner':
            known['by'] = 'owner'
            save_lessons(cfg, lessons)
        print(f'already a rule: {known["text"]}')
        return
    if clash and by == 'owner' and clash['by'] != 'owner':
        rules.remove(clash)
        print(f'the owner\'s rule replaces "{clash["text"]}"')
    elif clash and by != 'owner' and clash['by'] == 'owner':
        print(f'not written: the owner\'s rule stands – "{clash["text"]}". If it looks wrong, ask the owner.')
        return
    elif clash:
        question = cfg['texts']['rule_question'].format(old=clash['text'], old_by=clash['by'], new=text, new_by=by)
        if opts.issue:
            repo, number = resolve(cfg, opts.issue)
            ask_owner(cfg, repo, number, question, cfg['role'])
            print(f'not written: the rules disagree – asked the owner on {repo}#{number}')
        else:
            repo = cfg['repos'][0]
            number = create_issue(repo, cfg['texts']['rule_title'].format(topic=topic),
                                  f"🤖 {cfg['role']}: {question}", [cfg['labels']['question']])
            print(f'not written: the rules disagree – asked the owner in {repo}#{number}')
        return
    rules.append({'text': text, 'topic': topic, 'role': role, 'by': by, 'at': iso(now())})
    save_lessons(cfg, lessons)
    print(f'rule written: {text} ({by})')


def linked(cfg, repo):
    if repo not in [l['repo'] for l in cfg['links']]:
        raise Fail(f'{repo} is not a linked project (links: {", ".join(l["repo"] for l in cfg["links"]) or "none"}; '
                   f'agentq link adds one)')
    return repo


def cmd_move(cfg, opts):
    """All of it belongs to a linked project: transfer the issue there (or copy and close when GitHub refuses)."""
    repo, number = resolve(cfg, opts.issue)
    target = linked(cfg, opts.repo)
    issue = view(repo, number)
    names = labels_of(issue)
    owner = role_of_labels(cfg, names)  # no role label: the dispatcher is classifying it
    who = owner['role'] if owner else cfg['dispatcher']['name']
    ref = f'{repo}#{number}'
    comment(cfg, repo, number, cfg['texts']['moved'].format(repo=target, text=opts.text or '').strip(), who)
    ours = [r['label'] for r in cfg['roles']] + [cfg['labels']['working']]
    relabel(repo, number, remove=[n for n in names if n in ours])
    try:
        url = gh('issue', 'transfer', str(number), target, '-R', repo).strip().splitlines()[-1]
    except Fail:
        body = f"{cfg['texts']['moved_copy'].format(ref=ref)}\n\n{issue.get('body') or ''}"
        new = create_issue(target, issue['title'], body, [])
        gh('issue', 'close', str(number), '-R', repo, '--reason', 'not planned', '--comment', f'🤖 {who}: → {target}#{new}')
        url = f'{target}#{new}'
    print(f'{ref} → {url}')
    if owner and not opts.no_lesson:
        lessons = load_lessons(cfg)
        moved = lessons['examples'].setdefault('@moved', [])
        moved.append({'issue': f'#{number}', 'title': one_line(issue['title'], 100), 'to': target})
        del moved[:-int(cfg['lesson_examples'])]
        save_lessons(cfg, lessons)
        print(f'lesson recorded for the dispatcher: #{number} belonged to {target}')


def cmd_open(cfg, opts):
    """A new task for a role in this project (e.g. a finding for the programmer), with the role's label."""
    role = role_by_name(cfg, opts.role)
    repo = opts.repo or cfg['repos'][0]
    if repo not in cfg['repos']:
        raise Fail(f'{repo} is not in this config')
    number = create_issue(repo, opts.title, f"🤖 {opts.who or cfg['role']}: {opts.text}", [role['label']])
    print(f"{repo}#{number} opened for {role['role']}")


def cmd_split(cfg, opts):
    """A part belongs to a linked project: a new issue there that links back; this one stays."""
    repo, number = resolve(cfg, opts.issue)
    target = linked(cfg, opts.repo)
    ref = f'{repo}#{number}'
    who = holder(cfg, view(repo, number))
    body = f"🤖 {who}: {opts.text}\n\n{cfg['texts']['split_from'].format(ref=ref)}"
    new = create_issue(target, opts.title, body, [])
    comment(cfg, repo, number, cfg['texts']['split'].format(repo=target, other=f'{target}#{new}'), who)
    print(f'{target}#{new} created from {ref}; {ref} stays here')


def cmd_link(cfg, opts):
    """Sharing between projects: add, change or remove a linked project in this project's config."""
    def change(raw):
        links = [l for l in raw.get('links', []) if l['repo'] != opts.repo]
        if not opts.remove:
            if not re.match(r'^[\w.-]+/[\w.-]+$', opts.repo):
                raise Fail(f'"{opts.repo}" must be owner/repo')
            if not opts.about:
                raise Fail('say what belongs there, e.g. "the website: pages, blog, SEO"')
            links.append({'repo': opts.repo, 'about': opts.about})
        raw['links'] = links
    cfg = save_config(cfg, change)
    write_roles(cfg)
    for l in cfg['links']:
        print(f"{l['repo']}: {l['about']}")
    if not cfg['links']:
        print('no linked projects: sharing is off')


def cmd_pause(cfg, opts):
    """Pause the team: the watcher keeps running but plans nothing until `agentq resume`."""
    state = load_state(cfg)
    state['paused'] = {'at': iso(now()), 'why': opts.text or 'no reason given'}
    save_state(cfg, state)
    print(f"paused: the dispatcher gets no work until `agentq resume` ({state['paused']['why']})")


def cmd_resume(cfg, opts):
    state = load_state(cfg)
    was = state.pop('paused', None)
    save_state(cfg, state)
    print('resumed: the watcher plans again from its next poll' if was else 'was not paused')
    if not watcher_running(cfg):
        print(f"the watcher is not running: send the dispatcher ({cfg['dispatcher']['session'] or 'no session id in the config'}) "
              f'"Start the watcher"')


def cmd_roles(cfg, opts):
