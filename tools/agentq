def save_config(cfg, change):
    """Change the raw config (as written by the owner), write it back, return the reloaded config."""
    raw = copy.deepcopy(cfg['_raw'])
    change(raw)
    tmp = cfg['_path'] + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(raw, f, indent=2, ensure_ascii=False)
        f.write('\n')
    os.replace(tmp, cfg['_path'])
    return load_config(cfg['_path'])


BASE = '_loaded'  # the state as a command loaded it, so its save keeps what others changed meanwhile


class state_lock:
    """Several processes write the state (the watcher, workers, the dispatcher's commands): one at a time."""
    def __init__(self, cfg):
        self.path = cfg['state_file'] + '.lock'

    def __enter__(self):
        self.handle = open(self.path, 'a')
        fcntl.flock(self.handle, fcntl.LOCK_EX)

    def __exit__(self, *exc):
        self.handle.close()


def read_state_file(cfg):
    try:
        with open(cfg['state_file'], encoding='utf-8') as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return {}


def write_state_file(cfg, data):
    tmp = cfg['state_file'] + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, cfg['state_file'])


def load_state(cfg):
    state = read_state_file(cfg)
    state[BASE] = copy.deepcopy(state)
    return state


def merged(base, ours, disk):
    """Three-way, key by key: what this command changed since it loaded the state wins; what others changed
    meanwhile (a worker took a task, the owner paused the team) stays."""
    out = dict(disk)
    for key in set(base) | set(ours):
        if key not in ours:
            out.pop(key, None)
        elif key not in base or ours[key] != base[key]:
            if all(isinstance(x, dict) for x in (base.get(key), ours[key], disk.get(key))):
                out[key] = merged(base[key], ours[key], disk[key])
            else:
                out[key] = ours[key]
    return out


def save_state(cfg, state):
    ours = {k: v for k, v in state.items() if k != BASE}
    with state_lock(cfg):
        new = merged(state[BASE], ours, read_state_file(cfg)) if BASE in state else ours
        write_state_file(cfg, new)
    state.clear()
    state.update(new)
    state[BASE] = copy.deepcopy(new)


def update_state(cfg, change):
    """Read, change and write the state in one locked step; returns what change returns."""
    with state_lock(cfg):
        data = read_state_file(cfg)
        result = change(data)
        write_state_file(cfg, data)
    return result


# ---------- roles ----------

def role_by_name(cfg, name):
    for role in cfg['roles']:
        if role['role'].lower() == name.strip().lower():
            return role
    raise Fail(f'no role "{name}" (roles: {", ".join(r["role"] for r in cfg["roles"])})')


def role_of_labels(cfg, names):
    for role in cfg['roles']:
        if role['label'] in names:
            return role
    return None


def default_role(cfg):
    return role_by_name(cfg, cfg['default_role'])


def checked_label(cfg, role):
    return cfg['labels']['checked'].format(role=role['role'])


APP_SESSIONS = os.path.expanduser(os.environ.get('AGENTQ_APP_SESSIONS') or
                                  '~/Library/Application Support/Claude/claude-code-sessions')


def session_of(role, sid=None):
    """The session a plan sends to, by id only: a name invites the dispatcher to doubt it against names it remembers.
    When the desktop app's records show the session exists, the plan says so."""
    sid = sid or role['session']
    if not sid:
        return f"session (none in the config for {role['role']} – run setup)"
    seen = glob.glob(os.path.join(glob.escape(APP_SESSIONS), '*', '*', f'{glob.escape(sid)}.json'))
    return f"session {sid}" + (' (agentq checked: it exists)' if seen else '')


def pulls(role):
    """Its workers take tasks themselves (`agentq next`): codex, or both (Claude sessions and Codex workers compete)."""
    return role.get('agent', 'claude') != 'claude'


def pushes(role):
    """The dispatcher sends tasks to its Claude sessions: claude, or both."""
    return role.get('agent', 'claude') in ('claude', 'both')


def session_held(state, role, repo, issues):
    """The tasks this role's Claude sessions hold – not those a Codex worker took."""
    holders = state.get('holders', {})
    return [i for i in issues if holders.get(f"{repo}#{i['number']}") in (None, *role['sessions'])]


def capacity(role):
    return max(1, len(role['pool']))


def holder_of(state, role, ref):
    """The session of a role's pool that holds this task (recorded by assign); else the role's first session."""
    sid = state.get('holders', {}).get(ref)
    return sid if sid in role['sessions'] else role['session']


def free_session(state, role, held_refs, waiting=()):
    holders = state.get('holders', {})
    taken = {holders.get(r) for r in held_refs if holders.get(r) in role['sessions']}
    unknown = sum(1 for r in held_refs if holders.get(r) not in role['sessions'])
    free = [x for x in role['pool'] if x not in taken][unknown:]
    free = [x for x in free if x not in waiting] or free  # a waiting session takes its next task itself
    return free[0] if free else role['session']


# ---------- GitHub helpers ----------

def resolve(cfg, ref):
    m = REF.match(ref.strip())
    if not m:
        raise Fail(f'"{ref}" is not an issue (use N, #N or owner/repo#N)')
    repo = m.group(1) or cfg['repos'][0]
    if repo not in cfg['repos']:
        raise Fail(f'{repo} is not in this config (repos: {", ".join(cfg["repos"])})')
    return repo, int(m.group(2))


def labels_of(issue):
    return [l['name'] for l in issue.get('labels', [])]


def login_of(item):
    who = item.get('author') or item.get('user') or {}
    return who.get('login')


def one_line(text, size=200):
    text = ' '.join(text.split())
    return text if len(text) <= size else text[:size - 1] + '…'


def open_issues(repo):
    return gh_json('issue', 'list', '-R', repo, '--state', 'open', '--limit', '500',
                   '--json', 'number,title,labels,updatedAt,comments')


def board(repo):
    """The open issues without their comments: cheap enough to read every minute."""
    return gh_json('issue', 'list', '-R', repo, '--state', 'open', '--limit', '500',
                   '--json', 'number,title,labels,author,createdAt,updatedAt')


def view(repo, number):
    return gh_json('issue', 'view', str(number), '-R', repo, '--json', 'number,title,body,labels,state,author')


def comment(cfg, repo, number, text, who=None, agent=None):
    agent = agent or running_in()
    body = f"🤖 {who or cfg['role']}{' · ' + agent if agent else ''}: {text}"
    gh('issue', 'comment', str(number), '-R', repo, '--body', body)


def relabel(repo, number, add=(), remove=()):
    args = ['issue', 'edit', str(number), '-R', repo]
    for name in add:
        args += ['--add-label', name]
    for name in remove:
        args += ['--remove-label', name]
    if len(args) > 5:
        gh(*args)


def create_issue(repo, title, body, labels):
    args = ['issue', 'create', '-R', repo, '--title', title, '--body', body]
    for name in labels:
        args += ['--label', name]
    url = gh(*args).strip().splitlines()[-1]
    m = re.search(r'/issues/(\d+)$', url)
    if not m:
        raise Fail(f'gh issue create printed no issue link: {url}')
    return int(m.group(1))


def holder(cfg, issue):
    """Who writes on this issue: the role whose label it carries, else the session's own role."""
    role = role_of_labels(cfg, labels_of(issue))
    return role['role'] if role else cfg['role']


def trusted(cfg, issue):
    if cfg.get('accept_issues_from_others'):
        return True
    return login_of(issue) in set(cfg['owner_accounts']) | {cfg['agent_account']}


# ---------- 0.1 commands ----------

def cmd_queue(cfg, opts):
    state = load_state(cfg)
    started = now()
    lines = []
    for repo in cfg['repos']:
        since = state.get(repo, {}).get('last')
        issues = open_issues(repo)
        if since is None:
            lines.append(f'{repo}: first run – owner comments from now on will be shown.')
        else:
            since_t = parse_time(since)
            news = []
            for issue in issues:
                for c in issue.get('comments', []):
                    if c['author']['login'] in cfg['owner_accounts'] and parse_time(c['createdAt']) > since_t:
                        news.append(f"  {repo}#{issue['number']} {one_line(issue['title'], 60)}: {one_line(c['body'])}")
            lines.append(f'{repo}: owner comments since {since}: {len(news) or "none"}')
            lines.extend(news)
        working, todo, skipped = [], [], {}
        for issue in sorted(issues, key=lambda i: i['number']):
            names = labels_of(issue)
            hit = [n for n in names if n in cfg['skip']]
            row = f"  {repo}#{issue['number']} [{', '.join(names)}] {one_line(issue['title'], 100)}"
            if cfg['labels']['working'] in names:
                working.append(row)
            elif hit:
                for n in hit:
                    skipped[n] = skipped.get(n, 0) + 1
            else:
                todo.append(row)
        if working:
            lines.append(f'{repo}: in progress ({len(working)}):')
            lines.extend(working)
        lines.append(f'{repo}: queue ({len(todo)}):')
        lines.extend(todo)
        if opts.all and skipped:
            lines.append('  skipped: ' + ', '.join(f'{k} {v}' for k, v in sorted(skipped.items())))
        state.setdefault(repo, {})['last'] = iso(started)
    print('\n'.join(lines))
    if not opts.peek:
        save_state(cfg, state)


def cmd_take(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    comment(cfg, repo, number, cfg['texts']['take'], holder(cfg, view(repo, number)))
    relabel(repo, number, add=[cfg['labels']['working']])
    print(f'{repo}#{number}: taken')


def ask_owner(cfg, repo, number, text, who):
    comment(cfg, repo, number, cfg['texts']['ask'].format(text=text), who)
    relabel(repo, number, add=[cfg['labels']['question']], remove=[cfg['labels']['working']])


def cmd_ask(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    ask_owner(cfg, repo, number, opts.text, holder(cfg, view(repo, number)))
    print(f'{repo}#{number}: asked the owner, out of the queue')


def cmd_defer(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    who = holder(cfg, view(repo, number))
    comment(cfg, repo, number, cfg['texts']['defer'].format(text=opts.text or '').strip(), who)
    relabel(repo, number, add=[cfg['labels']['deferred']], remove=[cfg['labels']['working']])
    print(f'{repo}#{number}: deferred')


def cmd_wait(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    m = re.match(r'^([\w.-]+/[\w.-]+)#(\d+)$', opts.other.strip())
    if not m:
        raise Fail(f'"{opts.other}" must be owner/repo#N')
    ref = f'{m.group(1)}#{m.group(2)}'
    text = cfg['texts']['wait'].format(ref=ref) + f'\n<!-- agentq:wait {ref} -->'
    comment(cfg, repo, number, text, holder(cfg, view(repo, number)))
    relabel(repo, number, add=[cfg['labels']['waiting']], remove=[cfg['labels']['working']])
    print(f'{repo}#{number}: waits for {ref}')


def cmd_check(cfg, opts):
    moment = now()
    stale = dt.timedelta(hours=cfg['stale_hours'])
    report, fixed = [], []
    for repo in cfg['repos']:
        for issue in open_issues(repo):
            names = labels_of(issue)
            tag = f"{repo}#{issue['number']}"
            comments = issue.get('comments', [])
            if cfg['labels']['working'] in names and moment - parse_time(issue['updatedAt']) > stale:
                report.append(f"{tag}: '{cfg['labels']['working']}' but nothing happened for over {cfg['stale_hours']} h")
            if comments and comments[-1]['author']['login'] in cfg['owner_accounts']:
                report.append(f"{tag}: the owner's comment waits for an answer – {one_line(comments[-1]['body'], 120)}")
            if cfg['labels']['waiting'] in names:
                marks = [m for c in comments for m in WAIT_MARK.findall(c.get('body', ''))]
                if not marks:
                    report.append(f"{tag}: '{cfg['labels']['waiting']}' without a recorded issue to wait for")
                    continue
                other, other_n = marks[-1]
                ref = f'{other}#{other_n}'
                info = gh_json('issue', 'view', other_n, '-R', other, '--json', 'state')
                if info.get('state') == 'CLOSED':
                    if opts.fix:
                        comment(cfg, repo, issue['number'], cfg['texts']['back'].format(ref=ref))
                        relabel(repo, issue['number'], remove=[cfg['labels']['waiting']])
                        fixed.append(f'{tag}: {ref} closed – back in the queue')
                    else:
                        report.append(f'{tag}: {ref} is closed – run check --fix to put it back in the queue')
        done = gh_json('issue', 'list', '-R', repo, '--state', 'closed', '--label', cfg['labels']['working'],
                       '--limit', '100', '--json', 'number')
        for issue in done:
            tag = f"{repo}#{issue['number']}"
            if opts.fix:
                relabel(repo, issue['number'], remove=[cfg['labels']['working']])
                fixed.append(f"{tag}: closed – '{cfg['labels']['working']}' removed")
            else:
                report.append(f"{tag}: closed but still '{cfg['labels']['working']}'")
    for line in fixed:
        print('fixed  ' + line)
    for line in report:
        print('check  ' + line)
    if not fixed and not report:
        print('all consistent')


# ---------- the watcher and its plan ----------

def busy_with(cfg, issues, role, but=None):
    working = cfg['labels']['working']
    return [i for i in issues if i['number'] != but and role['label'] in labels_of(i) and working in labels_of(i)]


def next_issue(cfg, issues, role, skip_numbers=()):
    """Priority label → blocking label → oldest."""
    skip = cfg['skip'] | {cfg['labels']['working'], cfg['labels']['batch']}
    queue = [i for i in issues if role['label'] in labels_of(i) and not skip & set(labels_of(i)) and trusted(cfg, i)
             and i['number'] not in skip_numbers]
    queue.sort(key=lambda i: (cfg['labels']['priority'] not in labels_of(i),
                              cfg['labels']['blocking'] not in labels_of(i), i['number']))
    return queue[0] if queue else None


def path_hit(name, patterns):
    for p in patterns:
        p = p.rstrip('/')
        if name == p or name.startswith(p + '/') or fnmatch.fnmatch(name, p):
            return True
    return False


def touched(cfg, items, patterns):
    """Only the tasks whose commits (found by "#N" in the message, local git log) changed these paths."""
    if not items:
        return []
    if not cfg.get('checkout'):
        raise Fail('a path filter needs "checkout" (the project folder) in the config')
    numbers = {i['number'] for i in items}
    grep = '#(' + '|'.join(str(n) for n in sorted(numbers)) + ')([^0-9]|$)'
    out = git(cfg['checkout'], 'log', '--all', '-E', f'--grep={grep}', '--format=%x1e%B%x1f', '--name-only')
    hit = set()
    for chunk in out.split('\x1e')[1:]:
        message, _, files = chunk.partition('\x1f')
        refs = {int(n) for n in re.findall(r'#(\d+)\b', message)} & numbers
        if any(path_hit(f.strip(), patterns) for f in files.splitlines() if f.strip()):
            hit |= refs
    return [i for i in items if i['number'] in hit]


def unchecked(cfg, state, repo, role, cache):
    """Finished tasks this checker-mode role has not checked yet, oldest first."""
    since = role.get('since') or state.setdefault('checker_since', {}).setdefault(role['role'], iso(now()))
    if repo not in cache:
        first = min([since] + [r.get('since') or since for r in cfg['roles'] if r['mode'] == 'checker'])
        cache[repo] = gh_json('issue', 'list', '-R', repo, '--state', 'closed', '--limit', '300',
                              '--search', f'closed:>={first}',
                              '--json', 'number,title,labels,closedAt,stateReason,author')
    not_tasks = {checked_label(cfg, role), cfg['labels']['batch'], cfg['labels']['health']}
    items = [i for i in cache[repo]
             if parse_time(i['closedAt']) >= parse_time(since) and i.get('stateReason') != 'NOT_PLANNED'
             and not not_tasks & set(labels_of(i)) and trusted(cfg, i)]
    if role['paths']:
        items = touched(cfg, items, role['paths'])
    return sorted(items, key=lambda i: i['closedAt'])


def batch_ready(cfg, role, items, moment):
    if not items:
        return False
    return len(items) >= int(role['n']) or moment - parse_time(items[0]['closedAt']) >= dt.timedelta(hours=float(role['hours']))


def comment_key(c):
    """The same key for a comment from `gh issue list` (GraphQL) and from `gh api` (REST)."""
    return f"{login_of(c)}@{c.get('createdAt') or c.get('created_at')}"


def delivered_path(cfg):
    return cfg['state_file'] + '.delivered.json'


def load_delivered(cfg):
    try:
        with open(delivered_path(cfg), encoding='utf-8') as f:
            return json.load(f)
    except FileNotFoundError:
        return None


def mark_delivered(cfg, repo, comments, keep_hours):
    """The owner's comments that reached a role (brief printed them). Only brief and the first watch write this."""
    with state_lock(cfg):
        data = load_delivered(cfg) or {}
        marks = data.setdefault(repo, {})
        for c in comments:
            marks[comment_key(c)] = c.get('createdAt') or c.get('created_at')
        oldest = now() - dt.timedelta(hours=2 * keep_hours)
        data[repo] = {k: at for k, at in marks.items() if parse_time(at) >= oldest}
        tmp = delivered_path(cfg) + '.tmp'
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=1)
        os.replace(tmp, delivered_path(cfg))


def agent_set_working(cfg, state, repo, issue):
    """Busy means the agent account set the working label; one the owner's own tools set does not count."""
    key = f"{repo}#{issue['number']}"
    cache = state.setdefault('working_by', {})
    hit = cache.get(key)
    if hit and hit['at'] == issue.get('updatedAt'):
        return hit['agent']
    events = gh_pages('api', f"repos/{repo}/issues/{issue['number']}/events?per_page=100", '--paginate')
    setters = [e for e in events if e.get('event') == 'labeled'
               and (e.get('label') or {}).get('name') == cfg['labels']['working']]
    agent = not setters or (setters[-1].get('actor') or {}).get('login') == cfg['agent_account']
    cache[key] = {'at': issue.get('updatedAt'), 'agent': agent}
    return agent


def real_board(cfg, state, repo):
    """The open issues, with a working label the agent account did not set left out."""
    issues = board(repo)
    working = cfg['labels']['working']
    held = set()
    for issue in issues:
        if working in labels_of(issue):
            held.add(f"{repo}#{issue['number']}")
            if not agent_set_working(cfg, state, repo, issue):
                issue['labels'] = [l for l in issue['labels'] if l['name'] != working]
    cache = state.get('working_by', {})
    for key in [k for k in cache if k.startswith(repo + '#') and k not in held]:
        del cache[key]
    return issues


def session_activity(cfg, session):
    """When a desktop-app session last did anything: its transcript file's time. None when this cannot be seen."""
    if not session:
        return None
    metas = glob.glob(os.path.join(glob.escape(cfg['app_sessions']), '*', '*', f'{glob.escape(session)}.json'))
    try:
        with open(max(metas, key=os.path.getmtime), encoding='utf-8') as f:
            cli = json.load(f).get('cliSessionId')
    except (ValueError, OSError):
        return None
    files = glob.glob(os.path.join(glob.escape(cfg['transcripts']), '*', f'{glob.escape(cli or "-")}.jsonl'))
    if not files:
        return None
    return dt.datetime.fromtimestamp(max(os.path.getmtime(f) for f in files), dt.timezone.utc).replace(microsecond=0)


def quiet_holder(cfg, state, repo, ref, role, who, last, start, remind, release=True):
    """One reminder for a holder that went quiet; still quiet escalate_minutes later: the owner is told and the task
    goes back to the queue, so a free worker takes it."""
    nudges = state.setdefault('nudges', {})
    nudge = nudges.get(ref)
    if nudge and last > parse_time(nudge['at']):
        nudges.pop(ref)  # it reacted
        nudge = None
    if start - last < dt.timedelta(minutes=cfg['idle_minutes']):
        return
    if nudge is None:
        nudges[ref] = {'at': iso(start)}
        remind()
    elif not nudge.get('told') and start - parse_time(nudge['at']) >= dt.timedelta(minutes=cfg['escalate_minutes']):
        problem = cfg['texts']['stalled'].format(role=role['role'], ref=ref, session=who, last=iso(last), at=nudge['at'])
        report_health(cfg, state, [problem], needs_owner=True, close=False)
        nudge['told'] = iso(start)
        if release:
            number = int(ref.split('#')[1])
            comment(cfg, repo, number, cfg['texts']['released'].format(session=who, last=iso(last)), 'health')
            relabel(repo, number, remove=[cfg['labels']['working']])


def check_held(cfg, state, repo, issues, start, plan):
    """A role that holds a task but whose session went quiet gets one reminder; if it stays quiet, the owner is told.
    Seen without tokens from the session's transcript (a Codex task: its rollout file); where that cannot be seen,
    the dispatcher checks (get_session). A Codex worker gets its reminder as a queued message, without the dispatcher."""
    nudges = state.setdefault('nudges', {})
    checks = state.setdefault('held_checked', {})
    idle = dt.timedelta(minutes=cfg['idle_minutes'])
    held = set()
    for role in cfg['roles']:
        for issue in busy_with(cfg, issues, role):
            ref = f"{repo}#{issue['number']}"
            held.add(ref)
            holder = state.get('holders', {}).get(ref)
            codex = state.get('codex', {}).get(holder) if holder else None
            if codex:
                last = codex_activity(codex['thread']) if codex.get('host') == socket.gethostname() else None
                if last:
                    quiet_holder(cfg, state, repo, ref, role, holder, last, start,
                                 lambda: message_codex(codex['thread'], nudge_text(cfg, ref, iso(last))), release=False)
                continue
            if not pushes(role) or (holder and holder not in role['sessions']):
                continue  # another worker holds it: no session to watch here; health reports a stuck task
            sid = holder_of(state, role, ref)
            if not sid:
                continue
            last = session_activity(cfg, sid)
            if last is None:
                every = dt.timedelta(minutes=cfg['check_minutes'])
                if cfg['check_minutes'] and start - parse_time(issue['updatedAt']) >= idle and (
                        ref not in checks or start - parse_time(checks[ref]) >= every):
                    plan.append(('held', ref, role, issue['title'], None, sid))
                    checks[ref] = iso(start)
                continue
            quiet_holder(cfg, state, repo, ref, role, sid, last, start,
                         lambda: plan.append(('nudge', ref, role, issue['title'], iso(last), sid)))
    for table in (nudges, checks, state.setdefault('holders', {})):
        for ref in [r for r in table if r.startswith(repo + '#') and r not in held]:
            del table[ref]


def check_prs(cfg, state, repo, start, issues=()):
    """Hourly: an open pull request untouched for stale_pr_days becomes a task for the default role (once per stall)."""
    if not cfg['stale_pr_days']:
        return
    seen = state.setdefault('prs', {})
    last = seen.get(f'{repo}:checked')
    if last and start - parse_time(last) < dt.timedelta(hours=1):
        return
    seen[f'{repo}:checked'] = iso(start)
    role = default_role(cfg)
    for pr in gh_json('pr', 'list', '-R', repo, '--state', 'open', '--limit', '100',
                      '--json', 'number,title,updatedAt,url,isDraft'):
        key = f"{repo}#{pr['number']}"
        if start - parse_time(pr['updatedAt']) < dt.timedelta(days=cfg['stale_pr_days']) or seen.get(key) == pr['updatedAt']:
            continue
        texts = cfg['texts']
        title = texts['stale_pr_title'].format(number=pr['number'], days=cfg['stale_pr_days'])
        if any(i['title'] == title for i in issues):  # another dispatcher already opened it
            seen[key] = pr['updatedAt']
            continue
        create_issue(repo, title,
                     f"🤖 health: " + texts['stale_pr_body'].format(url=pr['url'], title=pr['title'], updated=pr['updatedAt']),
                     [role['label']])
        seen[key] = pr['updatedAt']


def tests_role(cfg):
    named = cfg['tests']['role']
    if named:
        return role_by_name(cfg, named)
    return next((r for r in cfg['roles'] if r['mode'] == 'checker'), default_role(cfg))


def check_tests(cfg, state, repo, start, plan):
    """Batched test mode: every N finished tasks the watcher runs the full suite itself, detached, in its own checkout
    (no tokens). Green is recorded; red wakes the checker once with the commit range since the last green run."""
    t = cfg['tests']
    if t['mode'] != 'batched' or not t['full'] or not t['checkout'] or repo != cfg['repos'][0]:
        return
    if t.get('host') and t['host'] != socket.gethostname():
        return  # with several dispatchers, the full suite runs on one computer
    ts = state.setdefault('tests', {})
    base = cfg['state_file'] + '.tests'
    run = ts.get('running')
    if run:
        code_file = f"{base}.{run['id']}.code"
        if os.path.exists(code_file):
            with open(code_file) as f:
                code = f.read().strip()
            sha = open(f"{base}.{run['id']}.sha").read().strip() if os.path.exists(f"{base}.{run['id']}.sha") else '?'
            ok = code == '0'
        elif start - parse_time(run['at']) > dt.timedelta(minutes=t['timeout_minutes']):
            try:
                os.killpg(run['pid'], 15)
            except OSError:
                pass
            ok, sha = False, run.get('sha', '?')
        else:
            return
        ts.pop('running')
        log = f"{base}.{run['id']}.log"
        ts['last'] = {'sha': sha, 'ok': ok, 'at': iso(start), 'log': log}
        if ok:
            ts['green'] = sha
        else:
            role = tests_role(cfg)
            line = cfg['texts']['tests_red'].format(sha=sha, green=ts.get('green') or 'none yet', log=log,
                                                    priority=cfg['labels']['priority'])
            plan.append(('tests_red', sha, role, line, None, role['session']))
        return
    ts.setdefault('since', iso(start))
    last = ts.get('counted')
    if last and start - parse_time(last) < dt.timedelta(minutes=5):
        return
    ts['counted'] = iso(start)
    not_tasks = {cfg['labels']['batch'], cfg['labels']['health']}
    done = [i for i in gh_json('issue', 'list', '-R', repo, '--state', 'closed', '--limit', '200', '--search',
                               f"closed:>={ts['since']}", '--json', 'number,labels,closedAt,stateReason')
            if parse_time(i['closedAt']) >= parse_time(ts['since']) and i.get('stateReason') != 'NOT_PLANNED'
            and not not_tasks & set(labels_of(i))]
    if len(done) < int(t['every']):
        return
    run_id = start.strftime('%Y%m%d%H%M%S')
    co = shlex_quote(t['checkout'])
    script = (f"cd {co} && git fetch -q origin && git checkout -q --detach origin/{shlex_quote(t['branch'])} && "
              f"git rev-parse HEAD > {shlex_quote(base + '.' + run_id + '.sha')} && ({t['full']}); "
              f"echo $? > {shlex_quote(base + '.' + run_id + '.code')}")
    with open(f'{base}.{run_id}.log', 'w') as log:
        proc = subprocess.Popen(['sh', '-c', script], stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    ts['running'] = {'id': run_id, 'pid': proc.pid, 'at': iso(start)}
    ts['since'] = iso(start)


def mark_urgent(cfg, repo, item, issues, urgent):
    """The owner wrote an urgent word (e.g. SKUBU) in the title, the text or a comment: the issue gets the priority
    label, so the next free session takes it first. Once per issue: a label the owner later removes stays removed."""
    ref = f"{repo}#{item['number']}"
    label = cfg['labels']['priority']
    if item.get('state', 'OPEN') != 'OPEN' or ref in urgent or label in labels_of(item):
        return
    owners = set(cfg['owner_accounts'])
    words = [w for w in cfg['priority_words'] if w]
    pattern = re.compile(r'(?<!\w)(' + '|'.join(re.escape(w) for w in words) + r')(?!\w)', re.I) if words else None
    texts = [c.get('body') or '' for c in item.get('comments', []) if login_of(c) in owners]
    if login_of(item) in owners:
        texts += [item.get('title') or '', item.get('body') or '']
    if pattern and any(pattern.search(t) for t in texts):
        relabel(repo, item['number'], add=[label])
        urgent[ref] = iso(now())
        for issue in issues:
            if issue['number'] == item['number']:
                issue['labels'] = issue['labels'] + [{'name': label}]


def build_plan(cfg, state, start):
    """Read the board; return the steps for the dispatcher. An owner's comment stays in the plan until a brief
    delivers it (up to forward_hours), so a missed plan or a stopped watcher loses nothing."""
    owners = set(cfg['owner_accounts'])
    labels = cfg['labels']
    waiting_word = {labels['question'], labels['owner_word']}
    window = start - dt.timedelta(hours=cfg['forward_hours'])
    delivered = load_delivered(cfg)
    plan = []
    boards = {}
    for repo in cfg['repos']:
        issues = real_board(cfg, state, repo)
        boards[repo] = {'at': iso(start), 'issues': issues}
        taken = set()
        news, fresh = {}, []
        first = delivered is None or repo not in delivered
        urgent = state.setdefault('urgent', {})
        for item in gh_json('issue', 'list', '-R', repo, '--state', 'all', '--limit', '100',
                            '--search', f'updated:>={iso(window)}', '--json', 'number,title,labels,state,comments,body,author'):
            mark_urgent(cfg, repo, item, issues, urgent)
            answered_at = max([c['createdAt'] for c in item.get('comments', [])
                               if login_of(c) == cfg['agent_account']] or [''])
            # first run: only words on an open issue that waits for the owner or is in progress, with no agent
            # comment after them, may not have reached a role; everything else counts as delivered
            if labels['health'] in labels_of(item):
                continue  # the owner's report, not a task
            open_wait = item.get('state', 'OPEN') == 'OPEN' and (waiting_word | {labels['working']}) & set(labels_of(item))
            for c in item.get('comments', []):
                if login_of(c) not in owners or not window <= parse_time(c['createdAt']) <= start:
                    continue
                if first and (c['createdAt'] < answered_at or not open_wait):
                    fresh.append(c)
                elif first or comment_key(c) not in delivered[repo]:
                    news.setdefault(item['number'], (item, []))[1].append(c['createdAt'])
        if first:
            mark_delivered(cfg, repo, fresh, cfg['forward_hours'])
        held = {i['number']: i for i in issues}
        for number, (item, times) in sorted(news.items()):
            if number in held:
                item = {**item, 'labels': held[number]['labels']}  # without a working label the owner set
            names = labels_of(item)
            role = role_of_labels(cfg, names)
            ref = f'{repo}#{number}'
            is_open = item.get('state', 'OPEN') == 'OPEN'
            if is_open and waiting_word & set(names):
                role = role or default_role(cfg)
                plan.append(('answered', ref, role, item['title'], None))
                taken.add(role['role'])
            elif not is_open or labels['working'] in names or cfg['skip'] & set(names):
                role = role or default_role(cfg)
                holder = state.get('holders', {}).get(ref)
                if not pushes(role) or (holder and holder not in role['sessions']):
                    continue  # a pulling worker reads new words when it runs `agentq done`
                claims = [m.group(1) for c in item.get('comments', []) for m in [CLAIM_MARK.search(c.get('body') or '')] if m]
                if claims and claims[-1].split('/')[0] != socket.gethostname():
                    continue  # another computer's dispatcher holds this task and forwards the words
                plan.append(('forward', ref, role, item['title'], min(times), holder_of(state, role, ref)))
            # an open issue without a role is classified below; a queued one carries the words in its brief
        check_held(cfg, state, repo, issues, start, plan)
        check_prs(cfg, state, repo, start, issues)
        check_tests(cfg, state, repo, start, plan)
        wake_codex(cfg, state, repo, issues, start)
        cache = {}
        for role in cfg['roles']:
            if not pushes(role):
                continue  # its workers take their own tasks with `agentq next`
            pulling = waiting_workers(cfg, role) & set(role['pool'])  # they take their next task themselves
            slots = capacity(role) - len(session_held(state, role, repo, busy_with(cfg, issues, role))) \
                - len(pulling) - (role['role'] in taken)
            picked = []
            while slots > 0:
                issue = next_issue(cfg, issues, role, picked)
                if not issue:
                    break
                picked.append(issue['number'])
                plan.append(('assign', f"{repo}#{issue['number']}", role, issue['title'], None))
                slots -= 1
            if slots > 0 and role['mode'] == 'checker' and not busy_with(cfg, issues, role) and role['sessions'] and \
                    batch_ready(cfg, role, unchecked(cfg, state, repo, role, cache), start):
                plan.append(('batch', repo, role, None, None))
        skip = cfg['skip'] | {labels['working'], labels['batch']}
        loose = [i for i in sorted(issues, key=lambda i: i['number'])
                 if not role_of_labels(cfg, labels_of(i)) and not skip & set(labels_of(i)) and trusted(cfg, i)]
        for issue in loose[:10]:
            plan.append(('classify', f"{repo}#{issue['number']}", None, issue['title'], None))
    save_board(cfg, boards)
    return plan


def render_plan(cfg, plan, start, clear=False, wake=False):
    q = 'agentq'
    lines = [f'agentq plan {iso(start)} – do every step in order, without asking anyone. The session ids come from '
             f'the config and are current, even when they differ from ids you saw before (the owner may replace a session).']
    for n, (kind, ref, role, title, since, *rest) in enumerate(plan, 1):
        sid = rest[0] if rest else None
        if kind == 'forward':
            line = cfg['texts']['send_news'].format(ref=ref, since=since)
            lines.append(f'{n}. the owner wrote on {ref} ({role["role"]}): send this line to {session_of(role, sid)}: `{line}`')
        elif kind == 'answered':
            lines.append(f'{n}. the owner answered on {ref}: run `{q} assign {ref} {role["role"]}` and do what it prints.')
        elif kind == 'assign':
            lines.append(f'{n}. next task for {role["role"]}: run `{q} assign {ref} {role["role"]}` and do what it prints.')
        elif kind == 'nudge':
            line = nudge_text(cfg, ref, since)
            lines.append(f'{n}. {role["role"]} holds {ref} but has been quiet since {since}: send this line to '
                         f'{session_of(role, sid)}: `{line}`')
        elif kind == 'tests_red':
            lines.append(f'{n}. the full test run is red at {ref}: send this line to {session_of(role, sid)}: `{title}`')
        elif kind == 'held':
            lines.append(f'{n}. {role["role"]} holds {ref}: call get_session for {sid or role["session"]}, then run '
                         f'`{q} held {ref} --running <its isRunning> --last <its lastActivityAt>` and do what it prints.')
        elif kind == 'batch':
            lines.append(f'{n}. a batch is ready for {role["role"]}: run `{q} batch {role["role"]} -R {ref}` '
                         f'and do what it prints.')
        else:
            moving = (f' If all of it belongs to a linked project in roles.md, run `{q} move {ref} <owner/repo>` '
                      f'instead.') if cfg['links'] else ''
            lines.append(f'{n}. classify {ref} "{one_line(title, 80)}": pick a role (roles.md; unsure → '
                         f'{cfg["default_role"]}), run `{q} assign {ref} <role>` and do what it prints.{moving}')
    if wake:  # a Codex dispatcher: its watcher keeps running
        lines.append('Last: end your turn – the watcher keeps running and sends the next plan here.')
    elif clear:  # the dispatcher needs no memory: the board and its files hold everything
        lines.append(f'Last: start `{q} watch` again in the background, then call clear_session with session_id "self".')
    else:
        lines.append(f'Last: start `{q} watch` again in the background.')
    return '\n'.join(lines)


def watch_lock(cfg, who=None):
    """One watcher per project and agent; with dispatcher agent "both" a Claude and a Codex watcher may run side by side."""
    handle = open(cfg['state_file'] + (f'.watch.{who}.lock' if who else '.watch.lock'), 'a')
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None
    return handle


def watcher_running(cfg):
    for who in (None, 'claude', 'codex'):
        lock = watch_lock(cfg, who)
        if lock is None:
            return True
        lock.close()
    return False


def agent_labels(cfg, agent):
    """The label saying which team works a task (for `agentq stats`), and the other one to remove."""
    mine, other = ('by_codex', 'by_claude') if agent == 'codex' else ('by_claude', 'by_codex')
    return [cfg['labels'][mine]], [cfg['labels'][other]]


def running_in():
    if os.environ.get('CODEX_THREAD_ID') or os.environ.get('CODEX_SANDBOX'):
        return 'codex'
    if os.environ.get('CLAUDECODE'):
        return 'claude'
    return None


def restart_if_updated(code):
    """agentq changed while this loop ran: carry on in the new version, without waking anyone."""
    if os.path.getmtime(os.path.realpath(__file__)) != code:
        sys.stdout.flush()
        os.execv(sys.executable, [sys.executable, os.path.realpath(__file__), *sys.argv[1:]])


# ---------- Codex tasks ----------
# Codex checks a running command with a model call about every minute, so a Codex task never waits in a command:
# it ends its turn, and a message queued for it (`codex queue`) starts its next turn – no tokens in between.

CODEX_HOME = os.path.expanduser(os.environ.get('CODEX_HOME') or '~/.codex')


def codex_cli():
    """AGENTQ_CODEX, else `codex` on PATH, else the Codex app's own CLI."""
    if 'AGENTQ_CODEX' in os.environ:
        return os.environ['AGENTQ_CODEX'] or None
    bundled = sorted(glob.glob('/Applications/*.app/Contents/Resources/codex-cli/*.app/Contents/MacOS/codex'))
    return shutil_which('codex') or (bundled[-1] if bundled else None)


def codex_loaded(thread):
    """A process – normally the Codex app – has the task loaded, so it runs a queued message once the task is idle."""
    lock = os.path.join(CODEX_HOME, 'thread-writer-locks', f'{thread}.lock')
    lsof = shutil_which('lsof') or '/usr/sbin/lsof'
    if not os.path.exists(lock) or not os.path.exists(lsof):
        return os.path.exists(lock)
    try:
        return bool(subprocess.run([lsof, '-t', lock], capture_output=True, text=True, timeout=30).stdout.strip())
    except subprocess.TimeoutExpired:
        return False


def codex_app_running():
    if 'AGENTQ_CODEX_APP' in os.environ:
        return os.environ['AGENTQ_CODEX_APP'] == '1'
    return subprocess.run(['pgrep', '-f', r'\.app/Contents/Resources/codex-cli/.*app-server'],
                          capture_output=True).returncode == 0


def codex_reachable(thread):
    """A message would run soon: the task is loaded, or the Codex app runs and loads it. Codex closed: nothing runs."""
    return codex_loaded(thread) or codex_app_running()


def codex_activity(thread):
    """When a Codex task last did anything: its rollout file's time. None when this cannot be seen."""
    files = glob.glob(os.path.join(glob.escape(CODEX_HOME), 'sessions', '*', '*', '*',
                                   f'rollout-*-{glob.escape(thread)}.jsonl'))
    if not files:
        return None
    return dt.datetime.fromtimestamp(max(os.path.getmtime(f) for f in files), dt.timezone.utc).replace(microsecond=0)


def message_codex(thread, text):
    """Queue a message for a Codex task; it runs as soon as the task is idle. A task the Codex app has not loaded
    (e.g. after the app restarted) is opened in the background, without taking focus, so the app loads it and runs
    the message. Returns (accepted, what went wrong): a message Codex may have accepted is never sent twice."""
    cli = codex_cli()
    if not cli:
        return False, 'no Codex CLI found (set AGENTQ_CODEX to its path)'
    try:
        run = subprocess.run([cli, 'queue', '--thread', thread, '--message', text], capture_output=True, text=True,
                             timeout=60)
    except OSError as e:
        return False, f'codex queue: {e}'
    except subprocess.TimeoutExpired:
        return True, 'codex queue did not answer in 60 s – the message may be queued'
    if run.returncode != 0:
        return False, one_line(run.stderr or run.stdout or f'codex queue exited with {run.returncode}', 300)
    if not codex_loaded(thread) and codex_app_running():
        try:
            opened = subprocess.run([os.environ.get('AGENTQ_OPEN') or 'open', '-g', f'codex://threads/{thread}'],
                                    capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as e:
            return True, f'queued, but opening the task failed: {e}'
        if opened.returncode != 0:
            return True, f'queued, but opening the task failed: {one_line(opened.stderr or str(opened.returncode), 200)}'
    return True, None


def start_codex_watcher(cfg, opts, who):
    """A Codex dispatcher never waits in a command (Codex checks a running command with a model call every minute):
    the watcher runs on its own and sends each plan to the dispatcher's Codex task as a message."""
    thread = os.environ.get('CODEX_THREAD_ID')
    if not thread:
        print('agentq watch: no CODEX_THREAD_ID, so no plan could reach this task – run it from a Codex task.')
        return 1
    update_state(cfg, lambda data: data.__setitem__('dispatcher_thread', thread))
    lock = watch_lock(cfg, who)
    if lock is None:
        print('agentq watch: already running – it sends each plan to this task now. End your turn.')
        return 0
    lock.close()
    args = [sys.executable, os.path.realpath(__file__), '--config', cfg['_path'], 'watch', '--wake']
    for name in ('interval', 'max_minutes'):
        if getattr(opts, name) is not None:
            args += [f"--{name.replace('_', '-')}", str(getattr(opts, name))]
    with open(cfg['state_file'] + '.watch.log', 'a') as log:
        child = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                                 start_new_session=True)
    for _ in range(50):  # up to 10 s for it to take its lock
        if child.poll() is not None:
            break
        held = watch_lock(cfg, who)
        if held is None:
            print('agentq watch: the watcher runs on its own now and sends each plan to this task as a message. '
                  'End your turn.')
            return 0
        held.close()
        time.sleep(0.2)
    print(f"agentq watch: the watcher did not start – see {cfg['state_file']}.watch.log. Tell the owner.")
    return 1


def cmd_watch(cfg, opts):
    here = running_in()
    agent = cfg['dispatcher']['agent']
    if here and agent != 'both' and here != agent:  # the team moved: this dispatcher stops, the other one runs
        print(f"agentq watch: this team's dispatcher runs on {agent} now – stop this loop.")
        return 1
    who = here if agent == 'both' else None
    if here == 'codex' and not opts.once and not opts.wake:
        return start_codex_watcher(cfg, opts, who)
    lock = watch_lock(cfg, who)
    if lock is None:
        print('agentq watch: already running – nothing to do.')
        return 0
    interval = cfg['poll_seconds'] if opts.interval is None else opts.interval
    code = os.path.getmtime(os.path.realpath(__file__))
    deadline = time.time() + 60 * opts.max_minutes if opts.max_minutes is not None else None
    while True:
        if deadline is not None and time.time() >= deadline:
            print('agentq watch: no work yet – run it again.')
            return 0
        if os.getppid() == 1 and not opts.wake:  # started with & or nohup: its end would wake nobody
            print('agentq watch: not started by the session (its parent is gone) – start it with run_in_background.')
            return 1
        restart_if_updated(code)
        state = load_state(cfg)
        start = now()
        work = copy.deepcopy(state)
        if state.get('paused'):  # the team is paused: stay alive, send nothing
            state['watch'] = {**state.get('watch', {}), 'pid': os.getpid(), 'beat': iso(start)}
            state['watch'].pop('error', None)
            save_state(cfg, state)
            if opts.once:
                print(f"agentq watch: paused since {state['paused']['at']} – {state['paused']['why']}")
                return 0
            time.sleep(interval)
            continue
        try:
            plan = build_plan(cfg, work, start)
            if here == 'codex':  # the Codex life: it sorts tasks; Claude sessions are the Claude dispatcher's to reach
                plan = [step for step in plan if step[0] in ('classify', 'answered')]
        except Fail as e:
            state['watch'] = {'pid': os.getpid(), 'beat': iso(start), 'error': str(e)}
            save_state(cfg, state)
            if opts.once:
                raise
        else:
            last = state.get('watch', {})
            count = state.get('plans', 0) + 1
            clear = bool(cfg['clear_every']) and count % int(cfg['clear_every']) == 0
            text = render_plan(cfg, plan, start, clear, opts.wake) if plan else ''
            body = text.split('\n', 1)[-1]
            work['watch'] = {'pid': os.getpid(), 'beat': iso(start), 'plan': last.get('plan'), 'sent': last.get('sent')}
            if plan and body == last.get('plan') and start - parse_time(last['sent']) < dt.timedelta(minutes=cfg['repeat_minutes']):
                plan = None  # the dispatcher did not act on this plan: do not wake it every minute for it
            elif plan and opts.wake:  # a Codex dispatcher: the plan goes to its task as a message
                accepted, error = message_codex(state.get('dispatcher_thread') or '-', text)
                if not accepted:
                    work['watch']['error'] = f'the plan did not reach the dispatcher: {error}'
                    plan = None  # tried again at the next poll
            if plan:
                work['watch'].update(exited=iso(start), plan=body, sent=iso(start))
                work['plans'] = count
            save_state(cfg, work)
            if plan and not opts.wake:
                print(text)
                return 0
            if opts.once:
                print('agentq watch: plan sent to the dispatcher.' if plan else 'agentq watch: no work.')
                return 0
        time.sleep(interval)


# ---------- dispatcher commands ----------

def session_settings(cfg, state, role, issue_labels, batch, sid=None):
    """The model and effort this task needs; a line for each that differs from what was last set."""
    want = {'model': role['model'], 'effort': role['effort']}
    if role['mode'] == 'checker' and not batch and role['release_model']:
        want['model'] = role['release_model']
    if cfg['labels']['hard'] in issue_labels and role['hard_effort']:
        want['effort'] = role['hard_effort']
    sid = sid or role['session']
    last = state.setdefault('sessions', {}).setdefault(sid or role['role'], {})
    lines = []
    for key, tool in (('model', 'set_session_model'), ('effort', 'set_session_effort')):
        if want[key] and want[key] != last.get(key):
            lines.append(f'{tool} for {session_of(role, sid)}: {want[key]}')
            last[key] = want[key]
    return lines


def print_send(cfg, state, role, ref, issue_labels, batch=False, sid=None):
    steps = session_settings(cfg, state, role, issue_labels, batch, sid)
    line = cfg['texts']['send_task'].format(ref=ref, role=role['role'])
    steps.append(f'send this line to {session_of(role, sid)}: `{line}`')
    for n, step in enumerate(steps, 1):
        print(f'{n}. {step}')


def claim(cfg, repo, number, text, who, agent=None):
    """GitHub has no lock: post a claim, read the comments back; the earliest claim of the last 10 minutes wins.
    A loser deletes its claim and returns False, so two dispatchers or workers on other computers never share a task."""
    mine = f'{socket.gethostname()}/{who}/{uuid.uuid4().hex[:8]}'
    comment(cfg, repo, number, f'{text}\n<!-- agentq:claim {mine} -->', who, agent)
    comments = gh_pages('api', f'repos/{repo}/issues/{number}/comments', '-H', FULL, '--paginate')
    recent = [c for c in comments if CLAIM_MARK.search(c.get('body') or '')
              and now() - parse_time(c['created_at']) <= dt.timedelta(minutes=10)]
    recent.sort(key=lambda c: (c['created_at'], c.get('id', 0)))
    if not recent or CLAIM_MARK.search(recent[0]['body']).group(1) == mine:
        return True
    for c in recent:
        if CLAIM_MARK.search(c['body']).group(1) == mine and c.get('id'):
            gh('api', '-X', 'DELETE', f"repos/{repo}/issues/comments/{c['id']}")
    return False


def waiting_dir(cfg):
    return cfg['state_file'] + '.waiting'


def mark_waiting(cfg, worker, role_names):
    os.makedirs(waiting_dir(cfg), exist_ok=True)
    with open(os.path.join(waiting_dir(cfg), worker.replace('/', '_')), 'w', encoding='utf-8') as f:
        json.dump({'worker': worker, 'roles': role_names}, f)


def unmark_waiting(cfg, worker):
    try:
        os.remove(os.path.join(waiting_dir(cfg), worker.replace('/', '_')))
    except OSError:
        pass


def waiting_workers(cfg, role):
    """Workers of this role waiting in `agentq next --wait` right now (a heartbeat in the last 150 seconds)."""
    found = set()
    for path in glob.glob(os.path.join(glob.escape(waiting_dir(cfg)), '*')):
        try:
            if time.time() - os.path.getmtime(path) > 150:
                continue
            with open(path, encoding='utf-8') as f:
                data = json.load(f)
        except (OSError, ValueError):
            continue
        if role['role'] in data.get('roles', []):
            found.add(data['worker'])
    return found


def shared_board(cfg, state, repo):
    """The board as the watcher last read it, when fresh; else read it now. Many waiting workers, one reader."""
    try:
        with open(cfg['state_file'] + '.board.json', encoding='utf-8') as f:
            snap = json.load(f).get(repo)
        if snap and now() - parse_time(snap['at']) <= dt.timedelta(seconds=2 * cfg['poll_seconds'] + 30):
            return snap['issues']
    except (OSError, ValueError, KeyError):
        pass
    return real_board(cfg, state, repo)


def save_board(cfg, boards):
    tmp = cfg['state_file'] + '.board.json.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(boards, f)
    os.replace(tmp, cfg['state_file'] + '.board.json')


def take_next(cfg, state, repo, issues, roles, worker, agent, skip=()):
    """Claim the next task of these roles for a worker: priority, then blocking, then the oldest, each read again on
    GitHub first (the board may be a minute old); else a checker's batch when one is ready. Returns (ref, role)."""
    labels = cfg['labels']
    add_agent, drop_agent = agent_labels(cfg, agent)
    candidates = []
    for role in roles:
        held = busy_with(cfg, issues, role)
        if not pushes(role) and role['pool'] and len(held) >= capacity(role):
            continue
        picked = list(skip)
        while True:  # this role's queue, in its order
            issue = next_issue(cfg, issues, role, picked)
            if not issue:
                break
            picked.append(issue['number'])
            candidates.append((role, issue))
    candidates.sort(key=lambda c: (labels['priority'] not in labels_of(c[1]),
                                   labels['blocking'] not in labels_of(c[1]), c[1]['number']))
    for role, issue in candidates:
        fresh = view(repo, issue['number'])
        if fresh.get('state', 'OPEN') != 'OPEN' or labels['working'] in labels_of(fresh) \
                or role['label'] not in labels_of(fresh):
            continue
        if claim(cfg, repo, issue['number'], cfg['texts']['take'], role['role'], agent):
            relabel(repo, issue['number'], add=[labels['working']] + add_agent,
                    remove=[n for n in drop_agent if n in labels_of(fresh)])
            ref = f"{repo}#{issue['number']}"
            state.setdefault('holders', {})[ref] = worker
            state.setdefault('last_team', {})[role['role']] = agent
            return ref, role
        # a loser goes on: another worker took that one a moment earlier
    for role in roles:
        if role['mode'] == 'checker' and not busy_with(cfg, issues, role):
            items = unchecked(cfg, state, repo, role, {})[:20]
            if batch_ready(cfg, role, items, now()):
                ref = create_batch(cfg, state, repo, role, items, add_agent)
                state.setdefault('holders', {})[ref] = worker
                return ref, role
    return None, None


def codex_here(state):
    """This Codex task's worker record, found by the task's id."""
    thread = os.environ.get('CODEX_THREAD_ID')
    for worker, info in state.get('codex', {}).items():
        if thread and info.get('thread') == thread:
            return worker, info
    return None, None


def note_finished(cfg):
    """A Codex worker finished a task: should its turn end without `agentq next`, the watcher still wakes it."""
    if running_in() != 'codex' or not os.environ.get('CODEX_THREAD_ID'):
        return

    def change(data):
        worker, info = codex_here(data)
        if info is not None:
            info['finished'] = iso(now())
    update_state(cfg, change)


def cmd_next(cfg, opts):
    """Take the next task and print its brief – the way every worker gets work. One role, or without a role any role
    this worker may pull for. A Claude session runs it with --wait in the background: it waits without tokens and
    wakes the session with the task. A Codex task never waits – Codex checks a running command with a model call
    every minute: with no task it ends its turn, and the watcher claims the next task for it and sends it a message."""
    here = running_in()
    host = socket.gethostname()
    session = os.environ.get('CLAUDE_CODE_HOST_SESSION_ID') if here == 'claude' else None
    thread = os.environ.get('CODEX_THREAD_ID') if here == 'codex' else None
    worker = opts.who or session or (f'codex-{thread[:8]}' if thread else None) or \
        f"{host.split('.')[0]}-{opts.role or 'team'}"

    def may(role):  # a role's own Claude session, or any worker of a role that pulls
        return worker in role['sessions'] or pulls(role)
    wanted = [role_by_name(cfg, opts.role)] if opts.role else cfg['roles']
    roles = [r for r in wanted if may(r)]
    again = ' '.join([shlex_quote(os.path.realpath(__file__)), 'next', *([shlex_quote(opts.role)] if opts.role else []),
                      '--as', shlex_quote(worker)])
    if thread:  # the watcher wakes this Codex task when one of these roles has work
        record = {'thread': thread, 'host': host, 'roles': [r['role'] for r in wanted], 'next': again}

        def register(data):  # one Codex task is one worker: a new name for the same task replaces the old one
            workers = data.setdefault('codex', {})
            for other in [w for w, i in workers.items() if i.get('thread') == thread and w != worker]:
                del workers[other]
            workers[worker] = {**record, 'idle': None}
        update_state(cfg, register)

    if not roles:
        if thread:
            update_state(cfg, lambda data: data['codex'][worker].__setitem__('idle', iso(now())))
            print(f"{', '.join(r['role'] for r in wanted)} does not take Codex workers now (agent: claude). End your "
                  f"turn: agentq sends this task a message when it does again.")
            return 0
        if opts.role:
            print(f"{wanted[0]['role']} does not pull (agent: claude) and {worker} is not its session: the dispatcher "
                  f"sends its tasks. Stop this loop.")
        else:
            print('no role this worker may pull for – `agentq role <name> --agent codex|both` first.')
        return 1
    agent = 'claude' if worker in {x for r in roles for x in r['sessions']} or here == 'claude' else 'codex'
    wait = opts.wait and here != 'codex'
    code = os.path.getmtime(os.path.realpath(__file__))
    deadline = time.time() + 60 * opts.max_minutes if opts.max_minutes is not None else None
    try:
        while True:
            if wait:
                if os.getppid() == 1:
                    print('agentq next: its session is gone – stop.')
                    return 1
                mark_waiting(cfg, worker, [r['role'] for r in roles])
            state = load_state(cfg)
            if not state.get('paused'):
                holders = state.setdefault('holders', {})
                for ref in [r for r, w in holders.items() if w == worker]:  # checked on GitHub, not in a snapshot
                    repo, number = ref.split('#')
                    fresh = view(repo, int(number)) if repo in cfg['repos'] else {}
                    if fresh.get('state', 'OPEN') == 'OPEN' and cfg['labels']['working'] in labels_of(fresh):
                        save_state(cfg, state)
                        print(f'you hold {ref} – finish it first (agentq done / ask / route / wait); its task again:')
                        cmd_brief(cfg, argparse.Namespace(issue=ref, since=None))
                        return 0
                    del holders[ref]
                for repo in cfg['repos']:
                    ref, role = take_next(cfg, state, repo, shared_board(cfg, state, repo), roles, worker, agent)
                    if ref:
                        save_state(cfg, state)
                        print(f'{ref} is yours now ({worker}).')
                        cmd_brief(cfg, argparse.Namespace(issue=ref, since=None))
                        return 0
            if thread:
                state.setdefault('codex', {}).setdefault(worker, record)['idle'] = iso(now())
                save_state(cfg, state)
                print(cfg['texts']['codex_idle'])
                return 0
            save_state(cfg, state)
            if here == 'codex':
                print('No task now, and this Codex task has no CODEX_THREAD_ID, so nothing can wake it: end your turn.')
                return 0
            if not wait or (deadline is not None and time.time() >= deadline):
                print(f"nothing yet – run `{again.replace(' --as', ' --wait --as', 1)}` again.")
                return 0
            time.sleep(cfg['poll_seconds'])
            restart_if_updated(code)
    finally:
        if wait:
            unmark_waiting(cfg, worker)


def reserve_codex(data, worker, seen, value):
    """Only one watcher wakes a worker: its record must still be as this watcher saw it."""
    info = data.get('codex', {}).get(worker)
    if not info or (info.get('idle'), info.get('finished')) != seen:
        return False
    info['idle'], info['finished'] = value
    return True


def wake_codex(cfg, state, repo, issues, start):
    """Idle Codex workers of this computer get their next task without tokens: the watcher claims it for them and
    queues one message for their Codex task. While Claude sessions wait for the same role, the teams take turns."""
    host = socket.gethostname()
    held_by = set(state.get('holders', {}).values())
    taken = []
    workers = state.get('codex', {})
    for worker in sorted(workers, key=lambda w: workers[w].get('idle') or workers[w].get('finished') or ''):
        info = workers[worker]
        if info.get('host') != host or worker in held_by:
            continue
        seen = (info.get('idle'), info.get('finished'))
        if not seen[0]:
            last = codex_activity(info['thread']) if seen[1] else None
            if not last or start - last < dt.timedelta(minutes=2):
                continue  # busy, or it may still run `agentq next` itself
        turns = state.get('last_team', {})
        roles = [r for r in cfg['roles'] if r['role'] in info.get('roles', []) and pulls(r)
                 and not (turns.get(r['role']) == 'codex' and waiting_workers(cfg, r))]
        if not any(next_issue(cfg, issues, r, taken) or r['mode'] == 'checker' for r in roles):
            continue
        if not codex_activity(info['thread']):
            continue  # the owner archived or deleted this Codex task: it gets nothing
        if not codex_reachable(info['thread']):
            continue  # Codex is closed: the task waits for Claude, or until the owner opens Codex
        if not update_state(cfg, lambda data: reserve_codex(data, worker, seen, (None, None))):
            continue  # another watcher on this computer woke it a moment ago
        ref, role = take_next(cfg, state, repo, issues, roles, worker, 'codex', taken)
        if not ref:
            update_state(cfg, lambda data: reserve_codex(data, worker, (None, None), seen))
            continue
        info['idle'] = info['finished'] = None
        update_state(cfg, lambda data: data.setdefault('holders', {}).__setitem__(ref, worker))
        number = int(ref.split('#')[1])
        taken.append(number)
        for issue in issues:
            if issue['number'] == number:
                issue['labels'] = issue['labels'] + [{'name': cfg['labels']['working']}]
        text = cfg['texts']['wake_task'].format(ref=ref, role=role['role'], worker=worker,
                                                agentq=shlex_quote(os.path.realpath(__file__)), next=info.get('next'))
        accepted, error = message_codex(info['thread'], text)
        if accepted:  # it may run any moment: the task stays its own; a reminder follows if it stays quiet
            info['error'] = error
        else:  # undone: the task back in the queue, the worker idle again for the next poll
            comment(cfg, repo, number, cfg['texts']['codex_unreached'].format(worker=worker, error=error), 'health')
            relabel(repo, number, remove=[cfg['labels']['working']])

            def undo(data):
                if data.get('holders', {}).get(ref) == worker:
                    del data['holders'][ref]
                if worker in data.get('codex', {}):
                    data['codex'][worker].update(idle=seen[0] or seen[1], finished=None, error=error)
            update_state(cfg, undo)
            state['holders'].pop(ref, None)
            info.update(idle=seen[0] or seen[1], finished=None, error=error)


def cmd_assign(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    role = role_by_name(cfg, opts.role)
    issue = view(repo, number)
    names = labels_of(issue)
    labels = cfg['labels']
    remove = [r['label'] for r in cfg['roles'] if r is not role and r['label'] in names]
    ref = f'{repo}#{number}'
    if opts.queue:  # sorting: the role label only; skip labels (question, deferred, …) stay
        relabel(repo, number, add=[role['label']], remove=remove)
        print(f"{ref} → {role['role']}, in its queue")
        return
    remove += [n for n in {labels['question'], labels['owner_word']} if n in names]  # the owner answered
    state = load_state(cfg)
    who = cfg['dispatcher']['name']
    if labels['working'] in names and role['label'] in names:
        print(f"{ref} is already being worked on as {role['role']} – nothing to do.")  # the other dispatcher was first
        return
    if not pushes(role) or running_in() == 'codex':  # a Codex dispatcher cannot reach Claude sessions: workers pull
        comment(cfg, repo, number, cfg['texts']['queued'].format(role=role['role']), who)
        relabel(repo, number, add=[role['label']], remove=remove)
        print(f"{ref} → {role['role']}, in its queue; it takes its tasks itself (agentq next). Nothing to send.")
        return
    busy = session_held(state, role, repo, busy_with(cfg, real_board(cfg, state, repo), role, but=number))
    if len(busy) >= capacity(role) or not role['sessions']:
        comment(cfg, repo, number, cfg['texts']['queued'].format(role=role['role']), who)
        relabel(repo, number, add=[role['label']], remove=remove)
        why = f"its sessions work on #{busy[0]['number']}" if busy else 'no Claude session'
        print(f"{ref} → {role['role']}, queued ({why}). Nothing to send.")
        return
    if not claim(cfg, repo, number, cfg['texts']['assign'].format(role=role['role']), who):
        print(f'{ref}: another dispatcher took it a moment earlier. Nothing to send.')
        return
    relabel(repo, number, add=[role['label'], labels['working'], *agent_labels(cfg, 'claude')[0]],
            remove=remove + [n for n in agent_labels(cfg, 'claude')[1] if n in names])
    waiting = waiting_workers(cfg, role)
    sid = free_session(state, role, [f"{repo}#{i['number']}" for i in busy], waiting)
    if sid in waiting:  # every free session waits in `agentq next`: one of them takes it itself – a message too would
        comment(cfg, repo, number, cfg['texts']['queued'].format(role=role['role']), who)  # give it two tasks
        relabel(repo, number, add=[role['label']], remove=remove)
        print(f"{ref} → {role['role']}, queued: a free session waiting in `agentq next` takes it itself. Nothing to send.")
        return
    state.setdefault('holders', {})[ref] = sid
    state.setdefault('last_team', {})[role['role']] = 'claude'
    print(f"{ref} → {role['role']}, working. Now:")
    print_send(cfg, state, role, ref, names, batch=labels['batch'] in names, sid=sid)
    save_state(cfg, state)


def shot_name(url, kind, n):
    ext = {'image/png': '.png', 'image/jpeg': '.jpg', 'image/gif': '.gif', 'image/webp': '.webp'}.get(kind)
    if not ext:
        ext = os.path.splitext(urllib.parse.urlparse(url).path)[1][:5] or '.img'
    return f'shot-{n}{ext}'


def repo_file(match):
    """A file in a (maybe private) repository, read through gh as the AI account."""
    owner, repo, ref, path = [g for g in match.groups() if g is not None]
    path = urllib.parse.quote(urllib.parse.unquote(path))
    run = subprocess.run(['gh', 'api', f'repos/{owner}/{repo}/contents/{path}?ref={ref}', '-H',
                          'Accept: application/vnd.github.raw'], capture_output=True)
    if run.returncode != 0:
        raise OSError(f'the AI account cannot read {owner}/{repo} (the owner invites it with Read access)')
    return run.stdout


def download_shots(rendered, folder, first):
    """Uploaded images have short-lived signed links in GitHub's rendered HTML that need no login, even in private
    repos; an image linked from a repository is read through gh."""
    paths = []
    for n, src in enumerate((html.unescape(s) for s in IMG.findall(rendered or '')), first):
        if urllib.parse.urlparse(src).scheme not in ('https', 'file'):  # file: only in tests
            continue
        try:
            in_repo = REPO_FILE.match(src)
            if in_repo:
                data, kind = repo_file(in_repo), ''
            else:
                with urllib.request.urlopen(src, timeout=30) as r:
                    data, kind = r.read(), (r.headers.get('Content-Type') or '').split(';')[0]
            os.makedirs(folder, exist_ok=True)
            path = os.path.join(folder, shot_name(src, kind, n))
            with open(path, 'wb') as f:
                f.write(data)
            paths.append(path)
        except OSError as e:
            paths.append(f'(could not download screenshot {n}: {e})')
    return paths


def cmd_brief(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    ref = f'{repo}#{number}'
    issue = gh_json('api', f'repos/{repo}/issues/{number}', '-H', FULL)
    comments = gh_pages('api', f'repos/{repo}/issues/{number}/comments', '-H', FULL, '--paginate')
    owners = set(cfg['owner_accounts'])
    since = parse_time(opts.since) if opts.since else None
    picked = [c for c in comments if login_of(c) in owners and (since is None or parse_time(c['created_at']) >= since)]
    names = labels_of(issue)
    role = role_of_labels(cfg, names) or default_role(cfg)
    folder = os.path.join(cfg['shots_dir'], repo.replace('/', '-'), str(number))
    texts = cfg['texts']
    out = [(texts['brief_news'] if since else texts['brief_head']).format(ref=ref, role=role['role']),
           f"Title: {issue['title']}"]
    shots = []
    if not since:
        author = login_of(issue)
        tag = 'the owner' if author in owners else 'an agent' if author == cfg['agent_account'] else 'NOT the owner'
        out += [f'Labels: {", ".join(names) or "none"}', f'--- issue text by {author} ({tag}) ---',
                (issue.get('body') or '(empty)').strip()]
        shots += download_shots(issue.get('body_html'), folder, 1)
    handover = [c for c in comments if login_of(c) == cfg['agent_account'] and ROUTE_MARK in (c.get('body') or '')]
    if handover and not since:  # the note of the role that handed it over (e.g. "merge branch …")
        c = handover[-1]
        out += [f"--- handed over, {c['created_at']} ---", c['body'].replace(ROUTE_MARK, '').strip()]
    for c in picked:
        out += [f"--- the owner ({login_of(c)}), {c['created_at']} ---", (c.get('body') or '').strip()]
        shots += download_shots(c.get('body_html'), folder, len(shots) + 1)
    if shots:
        out.append('--- screenshots, in order, as local files ---')
        out += shots
    mark_delivered(cfg, repo, picked, cfg['forward_hours'])
    if not since:
        batch = BATCH_MARK.search(issue.get('body') or '')
        finish = 'finish_batch' if batch else 'finish' if role['merge'] else 'finish_handoff'
        out += ['---', texts[finish].format(ref=ref, number=number, default=cfg['default_role'])]
        if cfg['links'] and not batch:
            out.append(texts['finish_links'].format(ref=ref))
        if not batch and role['mode'] == 'programmer':
            out.append(texts['tests_batched' if cfg['tests']['mode'] == 'batched' else 'tests_per_task']
                       .format(every=cfg['tests']['every']))
        live = cfg.get('live') or {}
        if live.get('command'):  # the owner's running copy: one role restarts it, nobody else
            if role['role'].lower() == live['role'].lower():
                green = load_state(cfg).get('tests', {}).get('green') if cfg['tests']['mode'] == 'batched' else None
                target = f'the last green commit, {green}' if green else 'the commit you checked'
                out.append(texts['live'].format(command=live['command'], target=target))
            else:
                out.append(texts['live_other'].format(role=live['role']))
        out.append(texts['after'].format(role=role['role']))
    print('\n'.join(out))


