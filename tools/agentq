def cmd_batch(cfg, opts):
    role = role_by_name(cfg, opts.role)
    if role['mode'] != 'checker':
        raise Fail(f'{role["role"]} is not a checker-mode role')
    repo = opts.repo or cfg['repos'][0]
    if repo not in cfg['repos']:
        raise Fail(f'{repo} is not in this config')
    busy = busy_with(cfg, board(repo), role)
    if busy:
        raise Fail(f"{role['role']} is busy with {repo}#{busy[0]['number']}")
    state = load_state(cfg)
    items = unchecked(cfg, state, repo, role, {})[:20]
    if not items:
        print(f'nothing for {role["role"]} to check')
        return
    if not opts.now and not batch_ready(cfg, role, items, now()):
        print(f'not ready: {len(items)} of {role["n"]}, the oldest closed {items[0]["closedAt"]} (--now to check anyway)')
        return
    refs = ' '.join(f"#{i['number']}" for i in items)
    commit = git(cfg['checkout'], 'rev-parse', 'HEAD').strip() if cfg.get('checkout') else 'not pinned (no checkout in the config)'
    body = cfg['texts']['batch_body'].format(role=role['role'], commit=commit,
                                             list='\n'.join(f"- #{i['number']} {i['title']}" for i in items))
    mark = json.dumps({'role': role['role'], 'issues': [i['number'] for i in items]})
    number = create_issue(repo, cfg['texts']['batch_title'].format(refs=refs), f'{body}\n\n<!-- agentq:batch {mark} -->',
                          [role['label'], cfg['labels']['batch'], cfg['labels']['working']])
    ref = f'{repo}#{number}'
    print(f"{ref} created: {role['role']} checks {refs}. Now:")
    print_send(cfg, state, role, ref, [], batch=True)
    save_state(cfg, state)


def cmd_checked(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    issue = view(repo, number)
    m = BATCH_MARK.search(issue.get('body') or '')
    if not m:
        raise Fail(f'{repo}#{number} is not a batch made by `agentq batch`')
    mark = json.loads(m.group(1))
    role = role_by_name(cfg, mark['role'])
    label = checked_label(cfg, role)
    for n in mark['issues']:
        relabel(repo, n, add=[label])
    refs = ' '.join(f'#{n}' for n in mark['issues'])
    comment(cfg, repo, number, cfg['texts']['checked'].format(refs=refs, text=opts.text or '').strip(), role['role'])
    relabel(repo, number, remove=[cfg['labels']['working']])
    gh('issue', 'close', str(number), '-R', repo)
    print(f"{repo}#{number}: {refs} labelled '{label}', batch closed")


# ---------- health ----------

def cmd_health(cfg, opts):
    state = load_state(cfg)
    moment = now()
    texts = cfg['texts']
    grace = dt.timedelta(minutes=cfg['watch_grace_minutes'])
    beat = state.get('watch', {})
    problems = []
    lock = watch_lock(cfg)
    if lock is not None:
        lock.close()
        exited = beat.get('exited')
        if not (exited and exited == beat.get('beat') and moment - parse_time(exited) < grace):
            problems.append(texts['health_watch'].format(since=beat.get('beat') or 'never'))
    elif beat.get('beat') and moment - parse_time(beat['beat']) > grace:
        problems.append(texts['health_stuck'].format(since=beat['beat']))
    if beat.get('error'):
        problems.append(texts['health_error'].format(error=beat['error']))
    stale = dt.timedelta(hours=cfg['stale_hours'])
    for repo in cfg['repos']:
        for issue in board(repo):
            if cfg['labels']['working'] in labels_of(issue) and moment - parse_time(issue['updatedAt']) > stale:
                problems.append(texts['health_stale'].format(ref=f"{repo}#{issue['number']}",
                                                             label=cfg['labels']['working'], hours=cfg['stale_hours']))
    repo = cfg['repos'][0]
    label = cfg['labels']['health']
    found = gh_json('issue', 'list', '-R', repo, '--state', 'open', '--label', label, '--limit', '5', '--json', 'number')
    report = '\n'.join(f'- {p}' for p in problems)
    if problems and found:
        comment(cfg, repo, found[0]['number'], '\n' + report, 'health')
        print(f"problems reported on {repo}#{found[0]['number']}:\n{report}")
    elif problems:
        number = create_issue(repo, texts['health_title'], f'🤖 health:\n{report}', [label])
        print(f'problems reported in {repo}#{number}:\n{report}')
    elif found:
        comment(cfg, repo, found[0]['number'], texts['health_ok'], 'health')
        gh('issue', 'close', str(found[0]['number']), '-R', repo)
        print(f"healthy; {repo}#{found[0]['number']} closed")
    else:
        print('healthy')


# ---------- setup ----------

def all_labels(cfg):
    names = {cfg['labels'][k]: k for k in ('working', 'question', 'deferred', 'waiting', 'priority', 'blocking',
                                            'hard', 'owner_word', 'batch', 'health')}
    for role in cfg['roles']:
        names.setdefault(role['label'], f'role: {role["role"]}')
        if role['mode'] == 'checker':
            names.setdefault(checked_label(cfg, role), f'checked by {role["role"]}')
    return names


def ensure_labels(cfg):
    wanted = all_labels(cfg)
    for repo in cfg['repos']:
        have = {l['name'] for l in gh_json('label', 'list', '-R', repo, '--limit', '300', '--json', 'name')}
        for name, what in wanted.items():
            if name not in have:
                gh('label', 'create', name, '-R', repo, '--color', 'BFBFBF', '--description', f'agentq: {what}')
                print(f'{repo}: label "{name}" created')


def install_dispatcher(cfg, folder):
    """Copy the dispatcher's template (only missing files), link the config, write roles.md."""
    folder = os.path.abspath(os.path.expanduser(folder))
    agentq = os.path.realpath(__file__)
    for base, _, files in os.walk(TEMPLATE):
        for name in files:
            source = os.path.join(base, name)
            target = os.path.join(folder, os.path.relpath(source, TEMPLATE))
            if os.path.exists(target):
                continue
            os.makedirs(os.path.dirname(target), exist_ok=True)
            with open(source, encoding='utf-8') as f:
                text = f.read().replace('{{agentq}}', agentq).replace('{{default_role}}', cfg['default_role'])
            with open(target, 'w', encoding='utf-8') as f:
                f.write(text)
            print(f'dispatcher: {target} written')
    link = os.path.join(folder, PROJECT_CONFIG)
    if not os.path.lexists(link):
        os.symlink(cfg['_path'], link)
        print(f'dispatcher: {link} → {cfg["_path"]}')
    return folder


def exclude_locally(top, *names):
    """Keep agentq's links out of the project's git without touching its .gitignore."""
    path = git(top, 'rev-parse', '--git-path', 'info/exclude').strip()
    path = path if os.path.isabs(path) else os.path.join(top, path)
    have = open(path, encoding='utf-8').read().split('\n') if os.path.exists(path) else []
    missing = [n for n in names if n not in have]
    if missing:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'a', encoding='utf-8') as f:
            f.write(('\n' if have and have[-1] else '') + '\n'.join(missing) + '\n')


def link(target, at):
    if os.path.lexists(at):
        return False
    os.makedirs(os.path.dirname(at), exist_ok=True)
    os.symlink(target, at)
    return True


def cmd_init(opts):
    """Install the team into one project: its own config, the skill link, both kept out of the project's git."""
    top = git(os.path.abspath(opts.project or '.'), 'rev-parse', '--show-toplevel').strip()
    repo = opts.repo
    if not repo:
        url = git(top, 'remote', 'get-url', 'origin').strip()
        m = re.search(r'github\.com[:/]([\w.-]+/[\w.-]+?)(?:\.git)?/?$', url)
        if not m:
            raise Fail(f'cannot tell the GitHub repository from "{url}" (pass --repo owner/name)')
        repo = m.group(1)
    path = os.path.expanduser(opts.config or f"~/.config/agentq/{repo.replace('/', '-')}.json")
    if os.path.exists(path):
        print(f'config exists: {path}')
    else:
        who = gh_json('api', 'user')
        with open(os.path.join(PACKAGE, 'config.example.json'), encoding='utf-8') as f:
            raw = json.load(f)
        raw.update({'owner_accounts': opts.owner, 'agent_account': who.get('login') or '', 'repos': [repo],
                    'checkout': top})
        raw['dispatcher']['folder'] = os.path.expanduser(f"~/agent-team/{repo.replace('/', '-')}-dispatcher")
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'w', encoding='utf-8') as f:
            json.dump(raw, f, indent=2, ensure_ascii=False)
            f.write('\n')
        print(f'config written: {path} (AI account: {raw["agent_account"] or "unknown – sign gh in"})')
    skill = os.path.join('.claude', 'skills', 'agent-team')
    if link(path, os.path.join(top, PROJECT_CONFIG)):
        print(f'{top}/{PROJECT_CONFIG} → {path}')
    if link(os.path.join(PACKAGE, 'skill', 'agent-team'), os.path.join(top, skill)):
        print(f'{top}/{skill} → the skill')
    exclude_locally(top, PROJECT_CONFIG, skill)
    print(f'installed in {top} only. Next: agentq setup (from the project folder).')


SESSION_BLOCK = re.compile(r'<!-- agentq:session -->.*?<!-- /agentq:session -->\n?', re.S)


def sync_dispatcher_session(cfg):
    """Write the dispatcher's own session id into its CLAUDE.md, so it never mistakes a role's id in a plan for its own."""
    path = os.path.join(cfg['team_dir'], 'CLAUDE.md')
    if not cfg['dispatcher']['folder'] or not os.path.exists(path):
        return
    own = cfg['dispatcher']['session']
    line = (f'Your own session id is `{own}`. Never send to it.' if own else
            'Your own session id is not recorded yet (`agentq role dispatcher --session <id>`).')
    block = (f'<!-- agentq:session -->\n{line} Every session id in a plan or in agentq\'s output belongs to a role '
             f'session, never to you: send to that session.\n<!-- /agentq:session -->\n')
    with open(path, encoding='utf-8') as f:
        text = f.read()
    if SESSION_BLOCK.search(text):
        new = SESSION_BLOCK.sub(lambda m: block, text, count=1)
    else:
        head, _, rest = text.partition('\n\n')
        new = f'{head}\n\n{block}\n{rest}'
    if new != text:
        with open(path, 'w', encoding='utf-8') as f:
            f.write(new)
        print(f'dispatcher: {path} – own session id {own or "not recorded yet"}')


def cmd_setup(cfg, opts):
    problems = []
    who = gh_json('api', 'user')
    login = who.get('login') if isinstance(who, dict) else None
    if login != cfg['agent_account']:
        problems.append(f"gh is signed in as {login or 'nobody'}, not the AI account {cfg['agent_account']} "
                        f"(the owner runs: gh auth login, or gh auth switch -u {cfg['agent_account']})")
    for repo in cfg['repos']:
        info = gh_json('api', f'repos/{repo}')
        rights = info.get('permissions', {}) if isinstance(info, dict) else {}
        if not rights.get('push'):
            problems.append(f'{cfg["agent_account"]} has no Write access to {repo} (the owner invites it with Write)')
        elif rights.get('admin'):
            problems.append(f'{cfg["agent_account"]} has Admin on {repo}; Write is enough (the owner lowers it)')
    if problems:
        print('missing – only the owner can fix these:\n' + '\n'.join(f'- {p}' for p in problems))
        return 1

    def fill(raw):
        raw.setdefault('roles', [{**r, 'session': ''} for r in DEFAULT_ROLES])
        for r in raw['roles']:
            if r.get('mode') == 'checker' and not r.get('since'):
                r['since'] = iso(now())
        if opts.group:
            raw['team_group'] = opts.group
        if opts.checkout:
            raw['checkout'] = os.path.abspath(os.path.expanduser(opts.checkout))
        disp = raw.setdefault('dispatcher', {})
        if opts.dispatcher_dir:
            disp['folder'] = os.path.abspath(os.path.expanduser(opts.dispatcher_dir))
        elif not disp.get('folder'):
            disp['folder'] = os.path.expanduser(f"~/agent-team/{cfg['repos'][0].replace('/', '-')}-dispatcher")
    cfg = save_config(cfg, fill)
    ensure_labels(cfg)
    install_dispatcher(cfg, cfg['dispatcher']['folder'])
    sync_dispatcher_session(cfg)
    write_roles(cfg)
    print_roles_table(cfg)
    return 0


def print_roles_table(cfg):
    print('role | label | mode | N | paths | model | effort | merge | session')
    for r in cfg['roles']:
        n = f"{r['n']}/{float(r['hours']):g}h" if r['mode'] == 'checker' else '-'
        print(f"{r['role']} | {r['label']} | {r['mode']} | {n} | {','.join(r['paths']) or '-'} | {r['model'] or '-'} | "
              f"{r['effort'] or '-'} | {'yes' if r['merge'] else 'no'} | {r['session'] or 'MISSING'}")
    d = cfg['dispatcher']
    print(f"dispatcher | - | - | - | - | {d.get('model') or '-'} | {d.get('effort') or '-'} | - | "
          f"{d['session'] or 'MISSING'} | folder {d['folder'] or '-'}")
    print(f"sidebar group: {cfg.get('team_group') or 'MISSING'}")


def cmd_role(cfg, opts):
    """Add or change a role (or the dispatcher's session) in the config, then create its labels."""
    name = opts.name.strip()

    def change(raw):
        if name.lower() == 'dispatcher':
            disp = raw.setdefault('dispatcher', {})
            for key in ('session', 'model', 'effort'):
                if getattr(opts, key) is not None:
                    disp[key] = getattr(opts, key)
            return
        roles = raw.setdefault('roles', [{**r, 'session': ''} for r in DEFAULT_ROLES])
        entry = next((r for r in roles if r['role'].lower() == name.lower()), None)
        if opts.remove:
            if entry:
                roles.remove(entry)
            return
        if entry is None:
            entry = {'role': name, **copy.deepcopy(PRESETS.get(name.lower(), {}))}
            roles.append(entry)
        for key in ('label', 'mode', 'n', 'hours', 'model', 'release_model', 'effort', 'hard_effort', 'session',
                    'description'):
            if getattr(opts, key) is not None:
                entry[key] = getattr(opts, key)
        if opts.paths is not None:
            entry['paths'] = [p.strip() for p in opts.paths.split(',') if p.strip()]
        if opts.example:
            entry['examples'] = opts.example
        for path in opts.shot or []:
            shots = entry.setdefault('shots', [])
            file = f"{entry['role'].replace(' ', '-')}-{len(shots) + 1}{os.path.splitext(path)[1].lower()}"
            os.makedirs(os.path.join(cfg['team_dir'], 'examples'), exist_ok=True)
            with open(os.path.expanduser(path), 'rb') as src, open(os.path.join(cfg['team_dir'], 'examples', file), 'wb') as dst:
                dst.write(src.read())
            shots.append(file)
        if opts.merge is not None:
            entry['merge'] = opts.merge == 'yes'
        if entry.get('mode') == 'checker' and not entry.get('since'):
            entry['since'] = iso(now())
        role_entry(entry)

    cfg = save_config(cfg, change)
    if len(cfg['roles']) == 0 or default_role(cfg) is None:
        raise Fail('the default role is gone')
    if not opts.remove:
        ensure_labels(cfg)
    sync_dispatcher_session(cfg)
    write_roles(cfg)
    print_roles_table(cfg)


# ---------- main ----------

def main(argv=None):
    p = argparse.ArgumentParser(prog='agentq', description='Task queue of an agent team on GitHub issues.')
    p.add_argument('--config', help='config file (default: AGENTQ_CONFIG, the nearest .agentq.json, ~/.config/agentq/config.json)')
    sub = p.add_subparsers(dest='cmd', required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument('--config', default=argparse.SUPPRESS, help='config file (also accepted before the command)')
    add_parser = sub.add_parser
    sub.add_parser = lambda *a, **k: add_parser(*a, parents=[common], **k)
    q = sub.add_parser('queue', help="the queue and the owner's new comments")
    q.add_argument('--all', action='store_true', help='also count skipped issues by label')
    q.add_argument('--peek', action='store_true', help='do not move the "since" mark')
    sub.add_parser('take', help='start an issue').add_argument('issue')
    a = sub.add_parser('ask', help='ask the owner; the issue leaves the queue')
    a.add_argument('issue')
    a.add_argument('text')
    d = sub.add_parser('defer', help='the owner deferred it')
    d.add_argument('issue')
    d.add_argument('text', nargs='?')
    w = sub.add_parser('wait', help='wait for an issue in another project')
    w.add_argument('issue')
    w.add_argument('other')
    c = sub.add_parser('check', help='find inconsistent states')
    c.add_argument('--fix', action='store_true')
    wt = sub.add_parser('watch', help='poll the board every minute; print a plan and exit when there is work')
    wt.add_argument('--once', action='store_true', help='poll once')
    wt.add_argument('--interval', type=float, help='seconds between polls (default: poll_seconds)')
    s = sub.add_parser('assign', help='give an issue to a role (working if the role is free, else queued)')
    s.add_argument('issue')
    s.add_argument('role')
    s.add_argument('--queue', action='store_true', help='only the role label: no comment, no start (sorting at setup)')
    b = sub.add_parser('brief', help="the issue's title, text, the owner's comments verbatim and screenshots as files")
    b.add_argument('issue')
    b.add_argument('--since', help="only the owner's comments from this time on")
    r = sub.add_parser('route', help='not mine: give it to another role (records a lesson for the dispatcher)')
    r.add_argument('issue')
    r.add_argument('role')
    r.add_argument('text', nargs='?')
    r.add_argument('--no-lesson', action='store_true', help='a hand-over, not a mistake: record no lesson')
    t = sub.add_parser('teach', help='a rule for the dispatcher, e.g. "banners → designer"')
    t.add_argument('rule')
    t.add_argument('--owner', action='store_true', help='the owner said it')
    t.add_argument('--issue', help='ask a contradiction on this issue instead of a new one')
    sub.add_parser('roles', help='the roles, rules and lessons the dispatcher reads')
    sub.add_parser('pause', help='pause the team: the watcher stays up but sends nothing').add_argument('text', nargs='?')
    sub.add_parser('resume', help='end a pause')
    mv = sub.add_parser('move', help='all of it belongs to a linked project: move the issue there')
    mv.add_argument('issue')
    mv.add_argument('repo')
    mv.add_argument('text', nargs='?')
    mv.add_argument('--no-lesson', action='store_true')
    sp = sub.add_parser('split', help='a part belongs to a linked project: a new issue there, linked to this one')
    sp.add_argument('issue')
    sp.add_argument('repo')
    sp.add_argument('title')
    sp.add_argument('text')
    ln = sub.add_parser('link', help='share tasks with another project (sharing is on while a link exists)')
    ln.add_argument('repo')
    ln.add_argument('about', nargs='?', help='what belongs there')
    ln.add_argument('--remove', action='store_true')
    dn = sub.add_parser('done', help='fixed: comment, drop the working label, close')
    dn.add_argument('issue')
    dn.add_argument('text')
    bt = sub.add_parser('batch', help='create the batch issue for a checker-mode role')
    bt.add_argument('role')
    bt.add_argument('-R', '--repo')
    bt.add_argument('--now', action='store_true', help='even if fewer than N and younger than the wait')
    ck = sub.add_parser('checked', help="a checker's batch is done: label every listed issue, close the batch")
    ck.add_argument('issue')
    ck.add_argument('text', nargs='?')
    sub.add_parser('health', help='watcher alive, no stale work; problems go to one health issue')
    su = sub.add_parser('setup', help='check access, write default roles, create labels and the dispatcher folder')
    su.add_argument('--checkout', help='the project folder (for path filters and pinned commits)')
    su.add_argument('--dispatcher-dir', help='the dispatcher folder (default ~/agent-team/<owner>-<repo>-dispatcher)')
    su.add_argument('--group', help="the id of the app's sidebar group holding the team's sessions")
    ro = sub.add_parser('role', help='add or change a role ("dispatcher" sets the dispatcher\'s session)')
    ro.add_argument('name')
    ro.add_argument('--label')
    ro.add_argument('--mode', choices=MODES)
    ro.add_argument('--n', type=int)
    ro.add_argument('--hours', type=number)
    ro.add_argument('--paths', help='comma-separated path prefixes or globs (checker mode)')
    ro.add_argument('--model')
    ro.add_argument('--release-model')
    ro.add_argument('--effort', choices=EFFORTS)
    ro.add_argument('--hard-effort', choices=EFFORTS)
    ro.add_argument('--merge', choices=('yes', 'no'))
    ro.add_argument('--session')
    ro.add_argument('--description')
    ro.add_argument('--example', action='append', help='an example task (repeat for 2–3)')
    ro.add_argument('--shot', action='append', help='a reference screenshot, copied into the dispatcher\'s examples/')
    ro.add_argument('--remove', action='store_true')
    ini = sub.add_parser('init', help='install the team into this project only: config, skill link, git exclude')
    ini.add_argument('--owner', action='append', required=True, help="the owner's GitHub login (repeat for more)")
    ini.add_argument('--repo', help='owner/name (default: from the git remote "origin")')
    ini.add_argument('--project', help='the project folder (default: here)')
    opts = p.parse_args(argv)
    if opts.cmd == 'init':
        try:
            cmd_init(opts)
            return 0
        except Fail as e:
            print(f'agentq: {e}', file=sys.stderr)
            return 1
    commands = {'queue': cmd_queue, 'take': cmd_take, 'ask': cmd_ask, 'defer': cmd_defer, 'wait': cmd_wait,
                'check': cmd_check, 'watch': cmd_watch, 'assign': cmd_assign, 'brief': cmd_brief, 'route': cmd_route,
                'teach': cmd_teach, 'roles': cmd_roles, 'done': cmd_done, 'batch': cmd_batch, 'checked': cmd_checked,
                'health': cmd_health, 'setup': cmd_setup, 'role': cmd_role, 'move': cmd_move, 'split': cmd_split,
                'link': cmd_link, 'pause': cmd_pause, 'resume': cmd_resume}
    try:
        cfg = load_config(find_config(opts.config))
        return commands[opts.cmd](cfg, opts) or 0
    except Fail as e:
        print(f'agentq: {e}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
