def unread_words(cfg, repo, number):
    """The owner's comments written after the last agent comment that no brief has delivered."""
    comments = gh_pages('api', f'repos/{repo}/issues/{number}/comments', '-H', FULL, '--paginate')
    last_agent = max([c['created_at'] for c in comments if login_of(c) == cfg['agent_account']] or [''])
    delivered = (load_delivered(cfg) or {}).get(repo, {})
    return [c for c in comments if login_of(c) in set(cfg['owner_accounts']) and c['created_at'] > last_agent
            and comment_key(c) not in delivered]


def cmd_done(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    issue = view(repo, number)
    unread = unread_words(cfg, repo, number)
    if unread:
        mark_delivered(cfg, repo, unread, cfg['forward_hours'])
        print(f'not closed: the owner wrote on {repo}#{number} while you worked – act on it, then run done again:')
        for c in unread:
            print(f"--- the owner ({login_of(c)}), {c['created_at']} ---\n{(c.get('body') or '').strip()}")
        return 1
    comment(cfg, repo, number, cfg['texts']['done'].format(text=opts.text), holder(cfg, issue))
    if cfg['labels']['working'] in labels_of(issue):
        relabel(repo, number, remove=[cfg['labels']['working']])
    if issue.get('state', 'OPEN') == 'OPEN':
        gh('issue', 'close', str(number), '-R', repo)
    print(f'{repo}#{number}: done')


def cmd_batch(cfg, opts):
    role = role_by_name(cfg, opts.role)
    if role['mode'] != 'checker':
        raise Fail(f'{role["role"]} is not a checker-mode role')
    repo = opts.repo or cfg['repos'][0]
    if repo not in cfg['repos']:
        raise Fail(f'{repo} is not in this config')
    state = load_state(cfg)
    busy = busy_with(cfg, real_board(cfg, state, repo), role)
    if busy:
        raise Fail(f"{role['role']} is busy with {repo}#{busy[0]['number']}")
    items = unchecked(cfg, state, repo, role, {})[:20]
    if not items:
        print(f'nothing for {role["role"]} to check')
        return
    if not opts.now and not batch_ready(cfg, role, items, now()):
        print(f'not ready: {len(items)} of {role["n"]}, the oldest closed {items[0]["closedAt"]} (--now to check anyway)')
        return
    ref = create_batch(cfg, state, repo, role, items, agent_labels(cfg, 'claude')[0])
    refs = ' '.join(f"#{i['number']}" for i in items)
    print(f"{ref} created: {role['role']} checks {refs}. Now:")
    print_send(cfg, state, role, ref, [], batch=True)
    save_state(cfg, state)


def create_batch(cfg, state, repo, role, items, extra=()):
    refs = ' '.join(f"#{i['number']}" for i in items)
    commit = git(cfg['checkout'], 'rev-parse', 'HEAD').strip() if cfg.get('checkout') else 'not pinned (no checkout in the config)'
    body = cfg['texts']['batch_body'].format(role=role['role'], commit=commit,
                                             list='\n'.join(f"- #{i['number']} {i['title']}" for i in items))
    if cfg['tests']['mode'] == 'batched':
        last = state.get('tests', {}).get('last')
        result = f"{'green' if last['ok'] else 'red'} at {last['sha']}" if last else 'not run yet'
        body += '\n' + cfg['texts']['tests_line'].format(result=result)
    mark = json.dumps({'role': role['role'], 'issues': [i['number'] for i in items]})
    number = create_issue(repo, cfg['texts']['batch_title'].format(refs=refs), f'{body}\n\n<!-- agentq:batch {mark} -->',
                          [role['label'], cfg['labels']['batch'], cfg['labels']['working'], *extra])
    return f'{repo}#{number}'


def cmd_checked(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    issue = view(repo, number)
    m = BATCH_MARK.search(issue.get('body') or '')
    if not m:
        raise Fail(f'{repo}#{number} is not a batch made by `agentq batch`')
    mark = json.loads(m.group(1))
    role = role_by_name(cfg, mark['role'])
    label = checked_label(cfg, role)
    for n in mark['issues']:
        relabel(repo, n, add=[label])
    refs = ' '.join(f'#{n}' for n in mark['issues'])
    comment(cfg, repo, number, cfg['texts']['checked'].format(refs=refs, text=opts.text or '').strip(), role['role'])
    relabel(repo, number, remove=[cfg['labels']['working']])
    gh('issue', 'close', str(number), '-R', repo)
    print(f"{repo}#{number}: {refs} labelled '{label}', batch closed")


# ---------- health ----------

def cmd_health(cfg, opts):
    state = load_state(cfg)
    moment = now()
    texts = cfg['texts']
    grace = dt.timedelta(minutes=cfg['watch_grace_minutes'])
    beat = state.get('watch', {})
    problems = []
    paused = state.get('paused')
    running = watcher_running(cfg)
    if paused:  # a pause is the owner's word; only a forgotten one is a problem
        if moment - parse_time(paused['at']) > dt.timedelta(hours=cfg['stale_hours']):
            problems.append(texts['health_paused'].format(since=paused['at'], why=paused['why']))
    elif not running:
        exited = beat.get('exited')
        if not (exited and exited == beat.get('beat') and moment - parse_time(exited) < grace):
            problems.append(texts['health_watch'].format(since=beat.get('beat') or 'never'))
    elif beat.get('beat') and moment - parse_time(beat['beat']) > grace:
        problems.append(texts['health_stuck'].format(since=beat['beat']))
    if beat.get('error'):
        problems.append(texts['health_error'].format(error=beat['error']))
    stale = dt.timedelta(hours=cfg['stale_hours'])
    for repo in cfg['repos']:
        for issue in board(repo):
            if cfg['labels']['working'] in labels_of(issue) and moment - parse_time(issue['updatedAt']) > stale:
                problems.append(texts['health_stale'].format(ref=f"{repo}#{issue['number']}",
                                                             label=cfg['labels']['working'], hours=cfg['stale_hours']))
    report_health(cfg, state, problems)
    save_state(cfg, state)


def report_health(cfg, state, problems, needs_owner=False, close=True):
    """One health issue for the owner: created, commented when the problems change, closed when all is well."""
    texts = cfg['texts']
    repo = cfg['repos'][0]
    label = cfg['labels']['health']
    found = gh_json('issue', 'list', '-R', repo, '--state', 'open', '--label', label, '--limit', '5', '--json', 'number')
    report = '\n'.join(f'- {p}' for p in problems)
    extra = [cfg['labels']['question']] if needs_owner else []
    if problems and found:
        number = found[0]['number']
        if report == state.get('health_report') and not needs_owner:
            print(f'problems unchanged since the last report on {repo}#{number}:\n{report}')
            return number
        comment(cfg, repo, number, '\n' + report, 'health')
        relabel(repo, number, add=extra)
        print(f"problems reported on {repo}#{number}:\n{report}")
    elif problems:
        number = create_issue(repo, texts['health_title'], f'🤖 health:\n{report}', [label] + extra)
        print(f'problems reported in {repo}#{number}:\n{report}')
    elif found and close:
        number = found[0]['number']
        comment(cfg, repo, number, texts['health_ok'], 'health')
        gh('issue', 'close', str(number), '-R', repo)
        print(f"healthy; {repo}#{number} closed")
    else:
        number = None
        print('healthy')
    state['health_report'] = report if problems else ''
    return number


def cmd_held(cfg, opts):
    """A role holds a task: is its session working on it? Remind it once when idle; tell the owner when that did not help."""
    repo, number = resolve(cfg, opts.issue)
    ref = f'{repo}#{number}'
    state = load_state(cfg)
    nudges = state.setdefault('nudges', {})
    moment = now()
    issue = view(repo, number)
    role = role_of_labels(cfg, labels_of(issue)) or default_role(cfg)
    if issue.get('state', 'OPEN') != 'OPEN' or cfg['labels']['working'] not in labels_of(issue):
        nudges.pop(ref, None)
        save_state(cfg, state)
        print(f'{ref} is not held any more – nothing to do.')
        return
    last = parse_time(opts.last)
    running = opts.running.strip().lower() in ('true', 'yes', '1', 'running')
    nudge = nudges.get(ref)
    if nudge and last > parse_time(nudge['at']):
        nudges.pop(ref)  # it reacted to the reminder
        nudge = None
    if running or moment - last < dt.timedelta(minutes=cfg['idle_minutes']):
        save_state(cfg, state)
        print(f"{role['role']} is working on {ref} – nothing to do.")
        return
    if nudge is None:
        nudges[ref] = {'at': iso(moment)}
        save_state(cfg, state)
        print(f"{role['role']} holds {ref} but has been idle since {iso(last)}. Now:")
        print(f'1. send this line to {session_of(role, holder_of(state, role, ref))}: `{nudge_text(cfg, ref, iso(last))}`')
        return
    if moment - parse_time(nudge['at']) >= dt.timedelta(minutes=cfg['escalate_minutes']) and not nudge.get('told'):
        problem = cfg['texts']['stalled'].format(role=role['role'], ref=ref, session=holder_of(state, role, ref) or '-',
                                                  last=iso(last), at=nudge['at'])
        where = report_health(cfg, state, [problem], needs_owner=True, close=False)
        nudge['told'] = iso(moment)
        save_state(cfg, state)
        print(f'told the owner in {repo}#{where} – nothing to send.')
        return
    print(f"reminded {role['role']} at {nudge['at']}; waiting – nothing to do.")


def nudge_text(cfg, ref, last):
    return cfg['texts']['nudge'].format(ref=ref, label=cfg['labels']['working'], last=last or 'a while')


def cmd_nudge(cfg, opts):
    repo, number = resolve(cfg, opts.issue)
    print(nudge_text(cfg, f'{repo}#{number}', opts.last))


